---
// RefiningTable.astro - High-Density Refining Matrix Table with SPF Ranking & Volume Indicators
---

<div class="refining-table-container panel" id="refining-table-container">
  <!-- Table Toolbar -->
  <div class="table-toolbar">
    <div class="toolbar-left">
      <div class="table-headline">
        <span class="toolbar-title">REFINING MATRIX</span>
        <span class="count-badge tabular-figures" id="items-count-badge">0 Items</span>
      </div>
      <div class="source-status" id="source-status-badge">
        <span class="status-dot"></span>
        <span class="status-label" id="source-status-label">Connecting to Engine...</span>
      </div>
    </div>

    <div class="toolbar-right">
      <div class="sort-controls">
        <span class="sort-label">SORT BY:</span>
        <div class="sort-buttons" role="group" aria-label="Sort Options">
          <button type="button" class="sort-btn active" data-sort="spf" title="Sort by Silver per Focus">
            SPF <span class="sort-arrow" id="sort-spf-arrow">▼</span>
          </button>
          <button type="button" class="sort-btn" data-sort="profit" title="Sort by Net Unit Profit">
            Profit <span class="sort-arrow" id="sort-profit-arrow"></span>
          </button>
          <button type="button" class="sort-btn" data-sort="volume" title="Sort by 24h Traded Volume">
            Volume <span class="sort-arrow" id="sort-volume-arrow"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scrollable Matrix Table -->
  <div class="table-scroll-wrapper">
    <table class="refining-table" id="refining-matrix-table" aria-label="Refining Matrix Table">
      <thead>
        <tr>
          <th scope="col" class="th-tier">TIER / ENC</th>
          <th scope="col" class="th-item">ITEM NAME</th>
          <th scope="col" class="th-city">BONUS CITY</th>
          <th scope="col" class="th-volume sortable-th" data-sort-key="volume">
            <span class="th-content">24H VOLUME <span class="col-sort-icon" id="col-sort-volume"></span></span>
          </th>
          <th scope="col" class="th-freshness">DATA AGE</th>
          <th scope="col" class="th-cost sortable-th" data-sort-key="cost">
            <span class="th-content">CRAFT COST <span class="col-sort-icon" id="col-sort-cost"></span></span>
          </th>
          <th scope="col" class="th-profit sortable-th" data-sort-key="profit">
            <span class="th-content">NET PROFIT <span class="col-sort-icon" id="col-sort-profit"></span></span>
          </th>
          <th scope="col" class="th-spf sortable-th active-sort" data-sort-key="spf">
            <span class="th-content">SILVER / FOCUS <span class="col-sort-icon" id="col-sort-spf">▼</span></span>
          </th>
          <th scope="col" class="th-daily sortable-th" data-sort-key="daily">
            <span class="th-content">DAILY YIELD (10k) <span class="col-sort-icon" id="col-sort-daily"></span></span>
          </th>
          <th scope="col" class="th-action">ACTION</th>
        </tr>
      </thead>
      <tbody id="refining-table-body">
        <!-- Rows populated dynamically by client-side script -->
        <tr class="loading-row">
          <td colspan="10" class="loading-cell">
            <div class="loading-spinner-wrap">
              <span class="loading-spinner"></span>
              <span>Loading refining calculations...</span>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Empty State Banner -->
  <div class="empty-state" id="table-empty-state" style="display: none;">
    <div class="empty-icon">⊘</div>
    <div class="empty-title">No Refining Recipes Found</div>
    <div class="empty-desc">No commodities match your current commodity/tier filters in this region. Try selecting "ALL" or switching region.</div>
  </div>

  <!-- Table Footer Legend -->
  <div class="table-legend">
    <div class="legend-item">
      <span class="legend-dot green"></span>
      <span>Fresh (&lt;15m)</span>
    </div>
    <div class="legend-item">
      <span class="legend-dot amber"></span>
      <span>Aging (15-60m)</span>
    </div>
    <div class="legend-item">
      <span class="legend-dot red"></span>
      <span>Stale (&gt;60m STALE)</span>
    </div>
    <div class="legend-divider"></div>
    <div class="legend-item">
      <span class="legend-spf-sample tabular-figures">54.2 SPF</span>
      <span>= Silver Saved / Focus Point</span>
    </div>
    <div class="legend-item">
      <span class="legend-note">All returns include biome city Resource Return Rate (RRR)</span>
    </div>
  </div>
</div>

<style>
  .refining-table-container {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Toolbar */
  .table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background-color: var(--surface-primary);
    border-bottom: 1px solid var(--border-hairline);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .table-headline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .count-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .source-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
  }

  .source-status .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-muted);
  }

  .source-status.live {
    border-color: rgba(78, 229, 182, 0.3);
    color: var(--accent-mint);
  }
  .source-status.live .status-dot {
    background-color: var(--accent-mint);
    box-shadow: 0 0 6px var(--accent-mint);
  }

  .source-status.offline {
    border-color: rgba(245, 166, 35, 0.3);
    color: var(--accent-amber);
  }
  .source-status.offline .status-dot {
    background-color: var(--accent-amber);
  }

  /* Sort Controls in Toolbar */
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sort-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .sort-buttons {
    display: inline-flex;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    padding: 2px;
    gap: 2px;
  }

  .sort-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    color: var(--text-secondary);
    background: transparent;
    transition: all 0.12s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .sort-btn:hover {
    color: var(--text-primary);
    background-color: var(--surface-elevated);
  }

  .sort-btn.active {
    color: #000;
    background-color: var(--accent-primary);
  }

  .sort-arrow {
    font-size: 0.65rem;
  }

  /* Scroll Wrapper */
  .table-scroll-wrapper {
    overflow-x: auto;
    overflow-y: visible;
    width: 100%;
    -webkit-overflow-scrolling: touch;
  }

  /* Table */
  .refining-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    text-align: left;
    white-space: nowrap;
  }

  .refining-table thead {
    background-color: var(--surface-primary);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .refining-table th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--border-hairline);
    user-select: none;
  }

  .refining-table th.sortable-th {
    cursor: pointer;
    transition: color 0.12s ease, background-color 0.12s ease;
  }

  .refining-table th.sortable-th:hover {
    color: var(--text-primary);
    background-color: rgba(199, 245, 59, 0.04);
  }

  .refining-table th.active-sort {
    color: var(--accent-primary);
  }

  .th-content {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .col-sort-icon {
    font-size: 0.65rem;
    width: 0.8rem;
    display: inline-block;
  }

  .refining-table th.th-volume,
  .refining-table th.th-cost,
  .refining-table th.th-profit,
  .refining-table th.th-spf,
  .refining-table th.th-daily {
    text-align: right;
  }

  .refining-table th.th-action {
    text-align: center;
  }

  /* Table Body */
  .refining-table tbody tr {
    border-bottom: 1px solid var(--border-hairline);
    transition: background-color 0.1s ease;
  }

  .refining-table tbody tr:hover {
    background-color: rgba(199, 245, 59, 0.035);
  }

  .refining-table td {
    padding: 0.6rem 0.75rem;
    vertical-align: middle;
  }

  /* Specific Columns Styling */
  .tier-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-primary);
  }

  .tier-t4 { border-color: #5A6270; color: #D1D5DB; }
  .tier-t5 { border-color: rgba(56, 189, 248, 0.4); color: #38BDF8; }
  .tier-t6 { border-color: rgba(245, 158, 11, 0.4); color: #F59E0B; }
  .tier-t7 { border-color: rgba(239, 68, 68, 0.4); color: #EF4444; }
  .tier-t8 { border-color: rgba(168, 85, 247, 0.5); color: #C084FC; }

  .item-cell {
    display: flex;
    flex-direction: column;
  }

  .item-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .item-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .city-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .city-name {
    font-weight: 500;
    color: var(--text-primary);
  }

  .rrr-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .num-cell-right {
    text-align: right;
  }

  /* 24h Volume & Liquidity */
  .volume-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .volume-num {
    font-weight: 600;
    color: var(--text-primary);
  }

  .liquidity-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.08rem 0.35rem;
    border-radius: 2px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .liquidity-badge.high {
    background-color: rgba(78, 229, 182, 0.12);
    border: 1px solid rgba(78, 229, 182, 0.3);
    color: var(--accent-mint);
  }

  .liquidity-badge.med {
    background-color: rgba(245, 166, 35, 0.12);
    border: 1px solid rgba(245, 166, 35, 0.3);
    color: var(--accent-amber);
  }

  .liquidity-badge.illiquid,
  .liquidity-badge.low {
    background-color: rgba(255, 77, 77, 0.12);
    border: 1px solid rgba(255, 77, 77, 0.3);
    color: var(--accent-danger);
  }

  /* Freshness Badge */
  .freshness-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    border: 1px solid transparent;
  }

  .freshness-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .freshness-badge.fresh {
    background-color: rgba(78, 229, 182, 0.08);
    border-color: rgba(78, 229, 182, 0.25);
    color: var(--accent-mint);
  }
  .freshness-badge.fresh .dot {
    background-color: var(--accent-mint);
  }

  .freshness-badge.aging {
    background-color: rgba(245, 166, 35, 0.08);
    border-color: rgba(245, 166, 35, 0.25);
    color: var(--accent-amber);
  }
  .freshness-badge.aging .dot {
    background-color: var(--accent-amber);
  }

  .freshness-badge.stale {
    background-color: rgba(255, 77, 77, 0.1);
    border-color: rgba(255, 77, 77, 0.3);
    color: var(--accent-danger);
  }
  .freshness-badge.stale .dot {
    background-color: var(--accent-danger);
  }

  /* Craft Cost */
  .cost-num {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .silver-unit {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-left: 0.2rem;
  }

  /* Net Profit & Margin */
  .profit-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .profit-num {
    font-weight: 700;
  }
  .profit-num.positive {
    color: var(--accent-mint);
  }
  .profit-num.negative {
    color: var(--accent-danger);
  }

  .margin-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .margin-badge.positive {
    color: var(--accent-mint);
  }
  .margin-badge.negative {
    color: var(--accent-danger);
  }

  /* SPF (Silver per Focus) Highlight */
  .spf-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .spf-value {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--accent-primary); /* Electric Lime */
    letter-spacing: -0.01em;
  }

  .spf-unit {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  /* Daily Yield */
  .yield-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .yield-num {
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Action Button */
  .action-cell {
    text-align: center;
  }

  .btn-math-audit {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.28rem 0.65rem;
    border-radius: 3px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .btn-math-audit:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background-color: rgba(199, 245, 59, 0.08);
  }

  /* Loading State */
  .loading-cell {
    padding: 3rem 1rem !important;
    text-align: center;
    color: var(--text-muted);
  }

  .loading-spinner-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .loading-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--border-hairline);
    border-top-color: var(--accent-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Empty State */
  .empty-state {
    padding: 3rem 1.5rem;
    text-align: center;
    background-color: var(--surface-primary);
  }

  .empty-icon {
    font-size: 2rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .empty-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }

  .empty-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto;
  }

  /* Table Legend */
  .table-legend {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.65rem 1rem;
    background-color: var(--surface-primary);
    border-top: 1px solid var(--border-hairline);
    font-size: 0.72rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .legend-dot.green { background-color: var(--accent-mint); }
  .legend-dot.amber { background-color: var(--accent-amber); }
  .legend-dot.red { background-color: var(--accent-danger); }

  .legend-divider {
    width: 1px;
    height: 12px;
    background-color: var(--border-hairline);
  }

  .legend-spf-sample {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-primary);
  }

  .legend-note {
    font-style: italic;
    color: var(--text-muted);
  }
</style>

<script>
  // TypeScript definition matching backend RefiningMatrixItem
  interface RefiningMatrixItem {
    item_id: string;
    commodity: string;
    tier: number;
    enchantment: number;
    city: string;
    is_bonus_city: boolean;
    item_value: number;
    raw_item_id: string;
    raw_amount: number;
    raw_price: number;
    prev_refined_item_id: string;
    prev_refined_amount: number;
    prev_refined_price: number;
    sell_price: number;
    station_fee: number;
    effective_raw_cost: number;
    effective_prev_cost: number;
    total_craft_cost: number;
    gross_revenue: number;
    sales_tax: number;
    setup_fee: number;
    net_revenue: number;
    profit_without_focus: number;
    profit_with_focus: number;
    focus_profit_delta: number;
    base_focus_cost: number;
    actual_focus_cost: number;
    silver_per_focus: number;
    daily_focus_silver: number;
    profit_margin_pct: number;
    rrr: number;
    is_chained: boolean;
    traded_volume_24h: number;
