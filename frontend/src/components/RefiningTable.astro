  // Item name map based on Albion Online official names
  const COMMODITY_NAMES: Record<string, Record<number, string>> = {
    wood: {
      4: "Pine Planks",
      5: "Cedar Planks",
      6: "Bloodoak Planks",
      7: "Ashenbark Planks",
      8: "Whitewood Planks"
    },
    ore: {
      4: "Bronze Bar",
      5: "Steel Bar",
      6: "Titanium Bar",
      7: "Runite Bar",
      8: "Meteorite Bar"
    },
    hide: {
      4: "Medium Leather",
      5: "Heavy Leather",
      6: "Robust Leather",
      7: "Thick Leather",
      8: "Reinforced Leather"
    },
    fiber: {
      4: "Fine Cloth",
      5: "Ornate Cloth",
      6: "Lavish Cloth",
      7: "Opulent Cloth",
      8: "Barbed Cloth"
    },
    stone: {
      4: "Travertine Block",
      5: "Granite Block",
      6: "Slate Block",
      7: "Basalt Block",
      8: "Marble Block"
    }
  };

  function getItemDisplayName(commodity: string, tier: number, enchantment: number): string {
    const commKey = commodity.toLowerCase();
    const baseName = COMMODITY_NAMES[commKey]?.[tier] || `${commodity} T${tier}`;
    if (enchantment > 0) {
      return `${baseName} (.${enchantment})`;
    }
    return baseName;
  }

  // Indonesian / Albion localized currency formatter
  function formatSilver(val: number): string {
    return Math.round(val).toLocaleString('id-ID');
  }

  function formatVolume(val: number): string {
    return val.toLocaleString('id-ID');
  }

  function formatAge(seconds: number): { text: string; cssClass: string } {
    if (seconds < 60) {
      return { text: "Just now", cssClass: "fresh" };
    }
    const mins = Math.floor(seconds / 60);
    if (mins < 15) {
      return { text: `${mins}m ago`, cssClass: "fresh" };
    }
    if (mins <= 60) {
      return { text: `${mins}m ago`, cssClass: "aging" };
    }
    return { text: `>60m STALE`, cssClass: "stale" };
  }

  function getLiquidityBadge(vol: number, isIlliquid: boolean): { text: string; cssClass: string } {
    if (isIlliquid || vol < 1000) {
      return { text: "Illiquid", cssClass: "illiquid" };
    }
    if (vol >= 10000) {
      return { text: "High", cssClass: "high" };
    }
    return { text: "Med", cssClass: "med" };
  }

  // State
  interface AppState {
    region: string;
    commodity: string;
    tier: string;
    stationTax: number;
    taxChannel: string;
    premium: boolean;
    chained: boolean;
    sortKey: 'spf' | 'profit' | 'volume' | 'cost' | 'daily';
    sortOrder: 'asc' | 'desc';
  }

  let state: AppState = {
    region: localStorage.getItem('albionflow_region') || 'asia',
    commodity: localStorage.getItem('albionflow_commodity') || 'ALL',
    tier: localStorage.getItem('albionflow_tier') || 'ALL',
    stationTax: parseInt(localStorage.getItem('albionflow_station_tax') || '600', 10),
    taxChannel: localStorage.getItem('albionflow_tax_channel') || 'sell_order',
    premium: localStorage.getItem('albionflow_premium') !== 'false',
    chained: localStorage.getItem('albionflow_chained') !== 'false',
    sortKey: 'spf',
    sortOrder: 'desc'
  };

  let rawData: RefiningMatrixItem[] = [];

  // DOM elements cache
  let tableBody: HTMLTableSectionElement | null = null;
  let emptyState: HTMLElement | null = null;
  let itemsCountBadge: HTMLElement | null = null;
  let sourceStatusBadge: HTMLElement | null = null;
  let sourceStatusLabel: HTMLElement | null = null;

  async function fetchMatrixData() {
    const channelParam = state.taxChannel === 'direct_trade' ? 'direct' : state.taxChannel;
    const url = new URL('http://localhost:8081/api/v1/refining/matrix');
    url.searchParams.set('region', state.region);
    url.searchParams.set('tax', state.stationTax.toString());
    url.searchParams.set('channel', channelParam);
    url.searchParams.set('premium', state.premium ? 'true' : 'false');
    url.searchParams.set('chained', state.chained ? 'true' : 'false');

    if (state.commodity && state.commodity !== 'ALL') {
      url.searchParams.set('commodity', state.commodity.toLowerCase());
    }
    if (state.tier && state.tier !== 'ALL') {
      const tNum = parseInt(state.tier.replace('T', ''), 10);
      if (!isNaN(tNum)) {
        url.searchParams.set('tier', tNum.toString());
      }
    }

    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 3000);
      const res = await fetch(url.toString(), { signal: controller.signal });
      clearTimeout(timeoutId);

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const data: RefiningMatrixItem[] = await res.json();
      rawData = data;
      updateStatusBadge(true, `Live API (${state.region.toUpperCase()})`);
    } catch (err) {
      // Backend offline or unreachable: fall back to rich client-side sample data
      rawData = recalculateFallbackData(FALLBACK_REFINING_DATA, state);
      updateStatusBadge(false, `Offline Snapshot (${state.region.toUpperCase()})`);
    }

    renderTable();
  }

  // Recalculates mathematical numbers for fallback sample data based on user station fee & tax
  function recalculateFallbackData(items: RefiningMatrixItem[], s: AppState): RefiningMatrixItem[] {
    let salesTaxRate = 0.04;
    let setupFeeRate = 0.025;

    const channel = s.taxChannel === 'direct_trade' ? 'direct' : s.taxChannel;
    if (channel === 'direct') {
      salesTaxRate = 0;
      setupFeeRate = 0;
    } else if (channel === 'instant_buy') {
      salesTaxRate = s.premium ? 0.04 : 0.08;
      setupFeeRate = 0;
    } else {
      // sell_order
      salesTaxRate = s.premium ? 0.04 : 0.08;
      setupFeeRate = 0.025;
    }

    return items.map((item) => {
      const rrr = 0.367;
      const nutrition = item.item_value * 0.1125;
      const stationFee = (nutrition * s.stationTax) / 100;
      const effectiveRaw = item.raw_amount * item.raw_price * (1 - rrr);
      const effectivePrev = item.prev_refined_amount * item.prev_refined_price * (1 - rrr);
      const totalCraftCost = effectiveRaw + effectivePrev + stationFee;

      const grossRev = item.sell_price;
      const salesTax = grossRev * salesTaxRate;
      const setupFee = grossRev * setupFeeRate;
      const netRev = grossRev - salesTax - setupFee;
      const profitNoFocus = netRev - totalCraftCost;
      const marginPct = totalCraftCost > 0 ? (profitNoFocus / totalCraftCost) * 100 : 0;

      // With focus calculation (53.9% RRR)
      const rrrFocus = 0.539;
      const effectiveRawFocus = item.raw_amount * item.raw_price * (1 - rrrFocus);
      const effectivePrevFocus = item.prev_refined_amount * item.prev_refined_price * (1 - rrrFocus);
      const totalCraftCostFocus = effectiveRawFocus + effectivePrevFocus + stationFee;
      const profitWithFocus = netRev - totalCraftCostFocus;
      const deltaProfit = profitWithFocus - profitNoFocus;
      const spf = item.actual_focus_cost > 0 ? deltaProfit / item.actual_focus_cost : 0;
      const dailyYield = spf * 10000;

      return {
        ...item,
        station_fee: stationFee,
        effective_raw_cost: effectiveRaw,
        effective_prev_cost: effectivePrev,
        total_craft_cost: totalCraftCost,
        sales_tax: salesTax,
        setup_fee: setupFee,
        net_revenue: netRev,
        profit_without_focus: profitNoFocus,
        profit_with_focus: profitWithFocus,
        focus_profit_delta: deltaProfit,
        silver_per_focus: spf,
        daily_focus_silver: dailyYield,
        profit_margin_pct: marginPct
      };
    });
  }

  function updateStatusBadge(isLive: boolean, text: string) {
    if (!sourceStatusBadge || !sourceStatusLabel) return;
    if (isLive) {
      sourceStatusBadge.className = 'source-status live';
    } else {
      sourceStatusBadge.className = 'source-status offline';
    }
    sourceStatusLabel.textContent = text;
  }

  function renderTable() {
    if (!tableBody) return;

    // Filter items according to state
    let filtered = rawData.filter((item) => {
      if (state.commodity && state.commodity !== 'ALL') {
        if (item.commodity.toUpperCase() !== state.commodity.toUpperCase()) {
          return false;
        }
      }
      if (state.tier && state.tier !== 'ALL') {
        const tNum = parseInt(state.tier.replace('T', ''), 10);
        if (!isNaN(tNum) && item.tier !== tNum) {
          return false;
        }
      }
      return true;
    });

    // Sort items
    filtered.sort((a, b) => {
      let valA = 0;
      let valB = 0;
      switch (state.sortKey) {
        case 'profit':
          valA = a.profit_without_focus;
          valB = b.profit_without_focus;
          break;
        case 'volume':
          valA = a.traded_volume_24h;
          valB = b.traded_volume_24h;
          break;
        case 'cost':
          valA = a.total_craft_cost;
          valB = b.total_craft_cost;
          break;
        case 'daily':
          valA = a.daily_focus_silver;
          valB = b.daily_focus_silver;
          break;
        case 'spf':
        default:
          valA = a.silver_per_focus;
          valB = b.silver_per_focus;
          break;
      }

      if (state.sortOrder === 'asc') {
        return valA > valB ? 1 : valA < valB ? -1 : 0;
      } else {
        return valA < valB ? 1 : valA > valB ? -1 : 0;
      }
    });

    // Update count badge
    if (itemsCountBadge) {
      itemsCountBadge.textContent = `${filtered.length} Items`;
    }

    // Toggle empty state
    if (filtered.length === 0) {
      tableBody.innerHTML = '';
      if (emptyState) emptyState.style.display = 'block';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';

    // Build rows HTML
    const htmlRows = filtered.map((item) => {
      const tierEnc = `T${item.tier}.${item.enchantment}`;
      const itemName = getItemDisplayName(item.commodity, item.tier, item.enchantment);
      const ageInfo = formatAge(item.price_age_seconds);
      const liqInfo = getLiquidityBadge(item.traded_volume_24h, item.is_illiquid);

      const isProfitPositive = item.profit_without_focus >= 0;
      const profitClass = isProfitPositive ? 'positive' : 'negative';
      const profitSign = isProfitPositive ? '+' : '';

      return `
        <tr data-item-id="${item.item_id}">
          <td class="td-tier">
            <span class="tier-badge tier-t${item.tier}">${tierEnc}</span>
          </td>
          <td class="td-item">
            <div class="item-cell">
              <span class="item-name">${itemName}</span>
              <span class="item-sub">${item.commodity} // ${item.item_id}</span>
            </div>
          </td>
          <td class="td-city">
            <div class="city-cell">
              <span class="city-name">${item.city}</span>
              <span class="rrr-tag tabular-figures">${(item.rrr * 100).toFixed(1)}% RRR</span>
            </div>
          </td>
          <td class="td-volume num-cell-right">
            <div class="volume-wrapper">
              <span class="volume-num tabular-figures">${formatVolume(item.traded_volume_24h)} unit</span>
              <span class="liquidity-badge ${liqInfo.cssClass}">${liqInfo.text}</span>
            </div>
          </td>
          <td class="td-freshness">
            <span class="freshness-badge ${ageInfo.cssClass}">
              <span class="dot"></span>
              ${ageInfo.text}
            </span>
          </td>
          <td class="td-cost num-cell-right">
            <span class="cost-num tabular-figures">${formatSilver(item.total_craft_cost)}</span>
            <span class="silver-unit">Silver</span>
          </td>
          <td class="td-profit num-cell-right">
            <div class="profit-wrapper">
              <span class="profit-num tabular-figures ${profitClass}">${profitSign}${formatSilver(item.profit_without_focus)} Silver</span>
              <span class="margin-badge tabular-figures ${profitClass}">${profitSign}${item.profit_margin_pct.toFixed(1)}%</span>
            </div>
          </td>
          <td class="td-spf num-cell-right">
            <div class="spf-wrapper">
              <span class="spf-value tabular-figures">${item.silver_per_focus.toFixed(1)}</span>
              <span class="spf-unit">Silver/Focus</span>
            </div>
          </td>
          <td class="td-daily num-cell-right">
            <div class="yield-wrapper">
              <span class="yield-num tabular-figures">${formatSilver(item.daily_focus_silver)}</span>
              <span class="silver-unit">Silver</span>
            </div>
          </td>
          <td class="td-action action-cell">
            <button
              type="button"
              class="btn-math-audit"
              data-item-id="${item.item_id}"
              title="Show exact formula breakdown and market fee audit"
            >
              Rincian Kalkulasi
            </button>
          </td>
        </tr>
      `;
    }).join('');

    tableBody.innerHTML = htmlRows;
    updateSortIndicators();
  }

  function updateSortIndicators() {
    // Update toolbar sort buttons
    const sortBtns = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
    sortBtns.forEach((btn) => {
      const key = btn.dataset.sort;
      const arrowSpan = btn.querySelector('.sort-arrow');
      if (key === state.sortKey) {
        btn.classList.add('active');
        if (arrowSpan) {
          arrowSpan.textContent = state.sortOrder === 'asc' ? '▲' : '▼';
        }
      } else {
        btn.classList.remove('active');
        if (arrowSpan) {
          arrowSpan.textContent = '';
        }
      }
    });

    // Update table header icons
    const thElements = document.querySelectorAll<HTMLTableCellElement>('.sortable-th');
    thElements.forEach((th) => {
      const key = th.dataset.sortKey;
      const iconSpan = th.querySelector('.col-sort-icon');
      if (key === state.sortKey) {
        th.classList.add('active-sort');
        if (iconSpan) {
          iconSpan.textContent = state.sortOrder === 'asc' ? '▲' : '▼';
        }
      } else {
        th.classList.remove('active-sort');
        if (iconSpan) {
          iconSpan.textContent = '';
        }
      }
    });
  }

  function setSort(key: AppState['sortKey']) {
    if (state.sortKey === key) {
      // Toggle order
      state.sortOrder = state.sortOrder === 'asc' ? 'desc' : 'asc';
    } else {
      state.sortKey = key;
      // Default to desc for spf, profit, volume, daily; asc for cost
      state.sortOrder = key === 'cost' ? 'asc' : 'desc';
    }
    renderTable();
  }

  function initRefiningTable() {
    tableBody = document.getElementById('refining-table-body') as HTMLTableSectionElement | null;
    emptyState = document.getElementById('table-empty-state');
    itemsCountBadge = document.getElementById('items-count-badge');
    sourceStatusBadge = document.getElementById('source-status-badge');
    sourceStatusLabel = document.getElementById('source-status-label');

    // Bind toolbar sort buttons
    const sortBtns = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort as AppState['sortKey'];
        if (key) setSort(key);
      });
    });

    // Bind column header click sorting
    const thElements = document.querySelectorAll<HTMLTableCellElement>('.sortable-th');
    thElements.forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.sortKey as AppState['sortKey'];
        if (key) setSort(key);
      });
    });

    // Event Delegation for "Rincian Kalkulasi" buttons
    if (tableBody) {
      tableBody.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const btn = target.closest('.btn-math-audit') as HTMLButtonElement | null;
        if (btn) {
          const itemId = btn.dataset.itemId;
          const foundItem = rawData.find((item) => item.item_id === itemId);
          if (foundItem) {
            // Dispatch custom event for ShowTheMathModal
            window.dispatchEvent(
              new CustomEvent('open-math-modal', {
                detail: foundItem
              })
            );
          }
        }
      });
    }

    // Global listeners for ControlBar and Header events
    const handleFilterUpdate = (detail: any) => {
      if (!detail) return;
      if (detail.commodity !== undefined) state.commodity = detail.commodity;
      if (detail.tier !== undefined) state.tier = detail.tier;
      if (detail.stationTax !== undefined) state.stationTax = detail.stationTax;
      if (detail.taxChannel !== undefined) state.taxChannel = detail.taxChannel;
      if (detail.premium !== undefined) state.premium = detail.premium;
      if (detail.chained !== undefined) state.chained = detail.chained;
      fetchMatrixData();
    };

    const handleRegionUpdate = (detail: any) => {
      if (detail && detail.region) {
        state.region = detail.region.toLowerCase();
        fetchMatrixData();
      }
    };

    window.addEventListener('albionflow:filter-changed', (e: any) => handleFilterUpdate(e.detail));
    window.addEventListener('control-bar-change', (e: any) => handleFilterUpdate(e.detail));

    window.addEventListener('albionflow:region-changed', (e: any) => handleRegionUpdate(e.detail));
    window.addEventListener('region-change', (e: any) => handleRegionUpdate(e.detail));

    window.addEventListener('albionflow:prices-refreshed', () => {
      fetchMatrixData();
    });

    // Initial fetch
    fetchMatrixData();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRefiningTable);
  } else {
    initRefiningTable();
  }
</script>
