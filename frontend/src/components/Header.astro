---
// Header.astro - AlbionFlow Anti-UI-Slop Top Navigation & Global Region Controller
const pathname = Astro.url.pathname;
const isRefining = pathname === '/' || pathname === '';
const isArbitrage = pathname.startsWith('/arbitrage');
---

<header class="header">
  <div class="header-inner">
    <div class="brand-section">
      <a href="/" class="brand-link">
        <span class="brand-logo">ALBIONFLOW</span>
        <span class="brand-tag">// REAL-TIME ARBITRAGE & REFINING ENGINE</span>
      </a>
    </div>

    <nav class="nav-section" aria-label="Primary Navigation">
      <a
        href="/"
        class:list={['nav-link', { active: isRefining }]}
      >
        <span class="nav-indicator"></span>
        Refining Optimizer
      </a>
      <a
        href="/arbitrage"
        class:list={['nav-link', { active: isArbitrage }]}
      >
        <span class="nav-indicator"></span>
        Hauling Matrix
      </a>
    </nav>

    <div class="actions-section">
      <div class="region-switcher" role="group" aria-label="Server Region">
        <span class="region-label">REGION:</span>
        <div class="region-buttons">
          <button type="button" class="region-btn active" data-region="asia">Asia</button>
          <button type="button" class="region-btn" data-region="americas">Americas</button>
          <button type="button" class="region-btn" data-region="europe">Europe</button>
        </div>
      </div>

      <button type="button" id="refresh-prices-btn" class="refresh-btn">
        <span class="refresh-indicator"></span>
        <span id="refresh-btn-text">Refresh Prices</span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--surface-primary);
    border-bottom: 1px solid var(--border-hairline);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0.65rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand-section {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .brand-logo {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--accent-primary);
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .nav-section {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hairline);
    background-color: var(--surface-elevated);
  }

  .nav-link.active {
    color: var(--text-primary);
    border-color: var(--border-hairline);
    background-color: var(--surface-elevated);
  }

  .nav-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: transparent;
    transition: background-color 0.15s ease;
  }

  .nav-link.active .nav-indicator {
    background-color: var(--accent-primary);
  }

  .actions-section {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .region-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .region-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .region-buttons {
    display: inline-flex;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    padding: 2px;
  }

  .region-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    transition: all 0.15s ease;
  }

  .region-btn:hover {
    color: var(--text-primary);
  }

  .region-btn.active {
    background-color: var(--surface-elevated);
    color: var(--accent-primary);
    border: 1px solid var(--border-hairline);
    font-weight: 700;
  }

  .refresh-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .refresh-btn:hover:not(:disabled) {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .refresh-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .refresh-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-mint);
  }

  .refresh-btn.loading .refresh-indicator {
    background-color: var(--accent-amber);
    animation: pulse-dot 1s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  @media (max-width: 900px) {
    .brand-tag {
      display: none;
    }
    .header-inner {
      padding: 0.5rem 0.75rem;
    }
  }
</style>

<script>
  // Region switcher and Price Refresh Handler
  function initHeader() {
    const regionButtons = document.querySelectorAll<HTMLButtonElement>('.region-btn');
    const refreshBtn = document.getElementById('refresh-prices-btn') as HTMLButtonElement | null;
    const refreshBtnText = document.getElementById('refresh-btn-text');

    // Read initial region from URL param or localStorage
    const urlParams = new URLSearchParams(window.location.search);
    const paramRegion = urlParams.get('region');
    const storedRegion = localStorage.getItem('albionflow_region');
    const currentRegion = (paramRegion || storedRegion || 'asia').toLowerCase();

    function setActiveRegion(region: string, updateUrl: boolean = true) {
      localStorage.setItem('albionflow_region', region);
      regionButtons.forEach((btn) => {
        if (btn.dataset.region === region) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('region', region);
        window.history.replaceState({}, '', url.toString());
      }

      window.dispatchEvent(
        new CustomEvent('albionflow:region-changed', {
          detail: { region }
        })
      );
    }

    // Apply active region on init
    setActiveRegion(currentRegion, false);

    regionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetRegion = btn.dataset.region;
        if (targetRegion) {
          setActiveRegion(targetRegion, true);
        }
      });
    });

    if (refreshBtn && refreshBtnText) {
      refreshBtn.addEventListener('click', async () => {
        const activeRegion = localStorage.getItem('albionflow_region') || 'asia';
        refreshBtn.disabled = true;
        refreshBtn.classList.add('loading');
        const originalText = refreshBtnText.textContent;
        refreshBtnText.textContent = 'Syncing...';

        try {
          const res = await fetch(`http://localhost:8081/api/v1/prices/refresh?region=${encodeURIComponent(activeRegion)}`, {
            method: 'POST'
          });

          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }

          refreshBtnText.textContent = 'Synced';
          window.dispatchEvent(
            new CustomEvent('albionflow:prices-refreshed', {
              detail: { region: activeRegion }
            })
          );
        } catch (err) {
          console.warn('[AlbionFlow] Failed to refresh prices:', err);
          refreshBtnText.textContent = 'Sync Failed';
        } finally {
          setTimeout(() => {
            refreshBtnText.textContent = originalText || 'Refresh Prices';
            refreshBtn.classList.remove('loading');
            refreshBtn.disabled = false;
          }, 2000);
        }
      });
    }
  }

  // Run on first load and client-side navigations
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
