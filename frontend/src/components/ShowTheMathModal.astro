  function openModal() {
    if (!backdrop) return;
    backdrop.classList.remove('modal-hidden');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (modalCloseBtn) modalCloseBtn.focus();
  }

  function closeModal() {
    if (!backdrop) return;
    backdrop.classList.add('modal-hidden');
    backdrop.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Copy to clipboard handler
  async function handleCopyDiscord() {
    if (!currentItem || !copyDiscordBtn || !copyDiscordText) return;

    const markdownText = generateDiscordMarkdown(currentItem);

    let copySuccess = false;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(markdownText);
        copySuccess = true;
      } catch (err) {
        console.warn('Clipboard API writeText failed, falling back to execCommand:', err);
      }
    }

    if (!copySuccess) {
      try {
        const textarea = document.createElement('textarea');
        textarea.value = markdownText;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        copySuccess = (document as any).execCommand('copy');
        document.body.removeChild(textarea);
      } catch (err) {
        console.error('Fallback execCommand copy failed:', err);
      }
    }

    if (copySuccess) {
      if (copyTimeoutId) clearTimeout(copyTimeoutId);
      copyDiscordBtn.classList.add('copied');
      copyDiscordText.textContent = '✓ Tersalin ke Clipboard!';
      copyTimeoutId = window.setTimeout(() => {
        copyDiscordBtn.classList.remove('copied');
        copyDiscordText.textContent = 'Salin Ringkasan (Discord/Guild)';
      }, 2500);
    }
  }

  // Initialize listeners
  function initModal() {
    // Listen for custom event from RefiningTable
    window.addEventListener('open-math-modal', ((e: CustomEvent) => {
      if (e.detail) {
        populateModal(e.detail);
        openModal();
      }
    }) as EventListener);

    // Close button listeners
    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', closeModal);
    }
    if (modalCloseFooterBtn) {
      modalCloseFooterBtn.addEventListener('click', closeModal);
    }

    // Overlay click listener
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) {
          closeModal();
        }
      });
    }

    // Escape key listener
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('modal-hidden')) {
        closeModal();
      }
    });

    // Copy Discord button listener
    if (copyDiscordBtn) {
      copyDiscordBtn.addEventListener('click', handleCopyDiscord);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModal);
  } else {
    initModal();
  }
</script>
