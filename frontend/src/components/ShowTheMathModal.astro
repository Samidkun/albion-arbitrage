</style>

<script>
  // TypeScript definition matching backend & RefiningTable
  interface RefiningMatrixItem {
    item_id: string;
    commodity: string;
    tier: number;
    enchantment: number;
    city: string;
    is_bonus_city: boolean;
    item_value: number;
    raw_item_id: string;
    raw_amount: number;
    raw_price: number;
    prev_refined_item_id: string;
    prev_refined_amount: number;
    prev_refined_price: number;
    sell_price: number;
    station_fee: number;
    effective_raw_cost: number;
    effective_prev_cost: number;
    total_craft_cost: number;
    gross_revenue: number;
    sales_tax: number;
    setup_fee: number;
    net_revenue: number;
    profit_without_focus: number;
    profit_with_focus: number;
    focus_profit_delta: number;
    base_focus_cost: number;
    actual_focus_cost: number;
    silver_per_focus: number;
    daily_focus_silver: number;
    profit_margin_pct: number;
    rrr: number;
    is_chained: boolean;
    traded_volume_24h: number;
    is_illiquid: boolean;
    price_age_seconds: number;
    freshness: string;
    is_stale: boolean;
  }

  // Official Albion Online Commodity & Raw Item Names
  const COMMODITY_NAMES: Record<string, Record<number, string>> = {
    wood: {
      3: 'Birch Planks',
      4: 'Pine Planks',
      5: 'Cedar Planks',
      6: 'Bloodoak Planks',
      7: 'Ashenbark Planks',
      8: 'Whitewood Planks'
    },
    ore: {
      3: 'Copper Bar',
      4: 'Bronze Bar',
      5: 'Steel Bar',
      6: 'Titanium Bar',
      7: 'Runite Bar',
      8: 'Meteorite Bar'
    },
    hide: {
      3: 'Thin Leather',
      4: 'Medium Leather',
      5: 'Heavy Leather',
      6: 'Robust Leather',
      7: 'Thick Leather',
      8: 'Reinforced Leather'
    },
    fiber: {
      3: 'Neat Cloth',
      4: 'Fine Cloth',
      5: 'Ornate Cloth',
      6: 'Lavish Cloth',
      7: 'Opulent Cloth',
      8: 'Barbed Cloth'
    },
    stone: {
      3: 'Sandstone Block',
      4: 'Travertine Block',
      5: 'Granite Block',
      6: 'Slate Block',
      7: 'Basalt Block',
      8: 'Marble Block'
    }
  };

  const RAW_NAMES: Record<string, Record<number, string>> = {
    wood: {
      4: 'Pine Logs',
      5: 'Cedar Logs',
      6: 'Bloodoak Logs',
      7: 'Ashenbark Logs',
      8: 'Whitewood Logs'
    },
    ore: {
      4: 'Iron Ore',
      5: 'Titanium Ore',
      6: 'Runite Ore',
      7: 'Meteorite Ore',
      8: 'Adamantium Ore'
    },
    hide: {
      4: 'Medium Hide',
      5: 'Heavy Hide',
      6: 'Robust Hide',
      7: 'Thick Hide',
      8: 'Hardened Hide'
    },
    fiber: {
      4: 'Hemp',
      5: 'Skyflower',
      6: 'Redleaf Cotton',
      7: 'Sunflax',
      8: 'Ghost Hemp'
    },
    stone: {
      4: 'Travertine',
      5: 'Granite',
      6: 'Slate',
      7: 'Basalt',
      8: 'Marble'
    }
  };

  function getItemDisplayName(commodity: string, tier: number, enchantment: number): string {
    const commKey = commodity.toLowerCase();
    const baseName = COMMODITY_NAMES[commKey]?.[tier] || `${commodity} T${tier}`;
    if (enchantment > 0) {
      return `${baseName} (.${enchantment})`;
    }
    return baseName;
  }

  function getRawDisplayName(commodity: string, tier: number, enchantment: number): string {
    const commKey = commodity.toLowerCase();
    const baseName = RAW_NAMES[commKey]?.[tier] || `${commodity} T${tier} Raw`;
    if (enchantment > 0) {
      return `${baseName} (.${enchantment})`;
    }
    return baseName;
  }

  function getPrevDisplayName(commodity: string, tier: number, enchantment: number): string {
    const prevTier = tier - 1;
    const commKey = commodity.toLowerCase();
    const baseName = COMMODITY_NAMES[commKey]?.[prevTier] || `${commodity} T${prevTier}`;
    if (enchantment > 0) {
      return `${baseName} (.${enchantment})`;
    }
    return baseName;
  }

  function formatSilver(val: number, decimals: number = 2): string {
    if (isNaN(val) || !isFinite(val)) return '0';
    const hasFraction = Math.abs(val % 1) > 0.001;
    const digs = hasFraction ? decimals : 0;
    return val.toLocaleString('id-ID', {
      minimumFractionDigits: digs,
      maximumFractionDigits: digs
    });
  }

  function formatNumber(val: number, decimals: number = 2): string {
    if (isNaN(val) || !isFinite(val)) return '0';
    return val.toLocaleString('id-ID', {
      minimumFractionDigits: val % 1 === 0 ? 0 : decimals,
      maximumFractionDigits: decimals
    });
  }

  // Active item in modal
  let currentItem: RefiningMatrixItem | null = null;
  let copyTimeoutId: number | null = null;

  // DOM Elements
  const backdrop = document.getElementById('math-modal-backdrop') as HTMLDivElement | null;
  const modalCloseBtn = document.getElementById('modal-close-btn') as HTMLButtonElement | null;
  const modalCloseFooterBtn = document.getElementById('modal-close-footer-btn') as HTMLButtonElement | null;
  const copyDiscordBtn = document.getElementById('copy-discord-btn') as HTMLButtonElement | null;
  const copyDiscordText = document.getElementById('copy-discord-text') as HTMLSpanElement | null;

  // Header Elements
  const modalTierBadge = document.getElementById('modal-tier-badge') as HTMLSpanElement | null;
  const modalCityBadge = document.getElementById('modal-city-badge') as HTMLSpanElement | null;
  const modalRrrBadge = document.getElementById('modal-rrr-badge') as HTMLSpanElement | null;
  const modalChainedBadge = document.getElementById('modal-chained-badge') as HTMLSpanElement | null;
  const modalItemName = document.getElementById('modal-item-name') as HTMLHeadingElement | null;
  const modalItemId = document.getElementById('modal-item-id') as HTMLSpanElement | null;
  const modalCommodityName = document.getElementById('modal-commodity-name') as HTMLSpanElement | null;
  const modalAgeCaption = document.getElementById('modal-age-caption') as HTMLSpanElement | null;

  // Step 1 Elements
  const stepRawDesc = document.getElementById('step-raw-desc') as HTMLElement | null;
  const stepRawNetTotal = document.getElementById('step-raw-net-total') as HTMLElement | null;
  const rawAmountVal = document.getElementById('raw-amount-val') as HTMLElement | null;
  const rawPriceVal = document.getElementById('raw-price-val') as HTMLElement | null;
  const rawGrossVal = document.getElementById('raw-gross-val') as HTMLElement | null;
  const rawRrrPct = document.getElementById('raw-rrr-pct') as HTMLElement | null;
  const rawRefundVal = document.getElementById('raw-refund-val') as HTMLElement | null;
  const rawNetVal = document.getElementById('raw-net-val') as HTMLElement | null;

  // Step 2 Elements
  const stepPrevDesc = document.getElementById('step-prev-desc') as HTMLElement | null;
  const stepPrevNetTotal = document.getElementById('step-prev-net-total') as HTMLElement | null;
  const stepPrevTable = document.getElementById('step-prev-table') as HTMLElement | null;
  const noPrevBox = document.getElementById('no-prev-box') as HTMLElement | null;
  const prevAmountVal = document.getElementById('prev-amount-val') as HTMLElement | null;
  const prevPriceSource = document.getElementById('prev-price-source') as HTMLElement | null;
  const prevPriceVal = document.getElementById('prev-price-val') as HTMLElement | null;
  const prevGrossVal = document.getElementById('prev-gross-val') as HTMLElement | null;
  const prevRrrPct = document.getElementById('prev-rrr-pct') as HTMLElement | null;
  const prevRefundVal = document.getElementById('prev-refund-val') as HTMLElement | null;
  const prevNetVal = document.getElementById('prev-net-val') as HTMLElement | null;

  // Step 3 Elements
  const stepStationFeeTotal = document.getElementById('step-station-fee-total') as HTMLElement | null;
  const stationIvVal = document.getElementById('station-iv-val') as HTMLElement | null;
  const stationNutVal = document.getElementById('station-nut-val') as HTMLElement | null;
  const stationTaxRateVal = document.getElementById('station-tax-rate-val') as HTMLElement | null;
  const stationFeeVal = document.getElementById('station-fee-val') as HTMLElement | null;

  // Step 4 Elements
  const totalCraftCostVal = document.getElementById('total-craft-cost-val') as HTMLElement | null;
  const craftCostEquation = document.getElementById('craft-cost-equation') as HTMLElement | null;

  // Step 5 Elements
  const stepNetRevTotal = document.getElementById('step-net-rev-total') as HTMLElement | null;
  const marketSellPriceVal = document.getElementById('market-sell-price-val') as HTMLElement | null;
  const marketTaxPct = document.getElementById('market-tax-pct') as HTMLElement | null;
  const marketTaxVal = document.getElementById('market-tax-val') as HTMLElement | null;
  const marketSetupPct = document.getElementById('market-setup-pct') as HTMLElement | null;
  const marketSetupVal = document.getElementById('market-setup-val') as HTMLElement | null;
  const marketNetRevenueVal = document.getElementById('market-net-revenue-val') as HTMLElement | null;

  // Step 6 Elements
  const stepSpfTotal = document.getElementById('step-spf-total') as HTMLElement | null;
  const profitNoFocusVal = document.getElementById('profit-no-focus-val') as HTMLElement | null;
  const profitMarginVal = document.getElementById('profit-margin-val') as HTMLElement | null;
  const profitWithFocusVal = document.getElementById('profit-with-focus-val') as HTMLElement | null;
  const profitDeltaVal = document.getElementById('profit-delta-val') as HTMLElement | null;
  const focusCostVal = document.getElementById('focus-cost-val') as HTMLElement | null;
  const focusBaseVal = document.getElementById('focus-base-val') as HTMLElement | null;
  const spfVal = document.getElementById('spf-val') as HTMLElement | null;
  const dailyFocusVal = document.getElementById('daily-focus-val') as HTMLElement | null;

  function populateModal(item: RefiningMatrixItem) {
    currentItem = item;

    const tierEnc = `T${item.tier}.${item.enchantment}`;
    const displayName = getItemDisplayName(item.commodity, item.tier, item.enchantment);
    const rawDisplayName = getRawDisplayName(item.commodity, item.tier, item.enchantment);
    const prevDisplayName = getPrevDisplayName(item.commodity, item.tier, item.enchantment);

    // Header updates
    if (modalTierBadge) {
      modalTierBadge.textContent = tierEnc;
      modalTierBadge.className = `tier-pill tier-t${item.tier}`;
    }
    if (modalCityBadge) {
      modalCityBadge.textContent = `${item.city} ${item.is_bonus_city ? '(Bonus City)' : ''}`;
    }
    if (modalRrrBadge) {
      modalRrrBadge.textContent = `${(item.rrr * 100).toFixed(1)}% Base RRR`;
    }
    if (modalChainedBadge) {
      modalChainedBadge.style.display = item.is_chained ? 'inline-block' : 'none';
    }
    if (modalItemName) modalItemName.textContent = displayName;
    if (modalItemId) modalItemId.textContent = item.item_id;
    if (modalCommodityName) modalCommodityName.textContent = item.commodity;

    if (modalAgeCaption) {
      const mins = Math.floor(item.price_age_seconds / 60);
      if (item.price_age_seconds < 60) {
        modalAgeCaption.textContent = 'Baru saja (< 1m)';
        modalAgeCaption.style.color = 'var(--accent-mint)';
      } else if (mins < 15) {
        modalAgeCaption.textContent = `Segar (${mins}m lalu)`;
        modalAgeCaption.style.color = 'var(--accent-mint)';
      } else if (mins <= 60) {
        modalAgeCaption.textContent = `Waspada (${mins}m lalu)`;
        modalAgeCaption.style.color = 'var(--accent-amber)';
      } else {
        modalAgeCaption.textContent = `KADALUARSA (>60m)`;
        modalAgeCaption.style.color = 'var(--accent-danger)';
      }
    }

    // Step 1: Raw Material
    const rawGross = item.raw_amount * item.raw_price;
    const rawRefundUnits = item.raw_amount * item.rrr;
    const rawRefundSilver = rawGross * item.rrr;

    if (stepRawDesc) {
      stepRawDesc.textContent = `${item.raw_amount}x ${rawDisplayName} (${item.raw_item_id})`;
    }
    if (stepRawNetTotal) stepRawNetTotal.textContent = `${formatSilver(item.effective_raw_cost)} Silver`;
    if (rawAmountVal) rawAmountVal.textContent = `${item.raw_amount} unit`;
    if (rawPriceVal) rawPriceVal.textContent = `${formatSilver(item.raw_price, 0)} Silver`;
    if (rawGrossVal) rawGrossVal.textContent = `${formatSilver(rawGross)} Silver`;
    if (rawRrrPct) rawRrrPct.textContent = `${(item.rrr * 100).toFixed(1)}%`;
    if (rawRefundVal) {
      rawRefundVal.textContent = `-${formatSilver(rawRefundSilver)} Silver (${formatNumber(rawRefundUnits, 2)} unit)`;
    }
    if (rawNetVal) rawNetVal.textContent = `${formatSilver(item.effective_raw_cost)} Silver`;

    // Step 2: Previous Tier Refined Material
    if (item.prev_refined_amount > 0) {
      if (stepPrevTable) stepPrevTable.style.display = 'flex';
      if (noPrevBox) noPrevBox.style.display = 'none';

      const prevGross = item.prev_refined_amount * item.prev_refined_price;
      const prevRefundUnits = item.prev_refined_amount * item.rrr;
      const prevRefundSilver = prevGross * item.rrr;

      if (stepPrevDesc) {
        stepPrevDesc.textContent = `${item.prev_refined_amount}x ${prevDisplayName} (${item.prev_refined_item_id})`;
      }
      if (stepPrevNetTotal) stepPrevNetTotal.textContent = `${formatSilver(item.effective_prev_cost)} Silver`;
      if (prevAmountVal) prevAmountVal.textContent = `${item.prev_refined_amount} unit`;
      if (prevPriceSource) {
        prevPriceSource.textContent = item.is_chained ? 'Chained Craft Cost' : 'Harga Pasar';
      }
      if (prevPriceVal) prevPriceVal.textContent = `${formatSilver(item.prev_refined_price, 0)} Silver`;
      if (prevGrossVal) prevGrossVal.textContent = `${formatSilver(prevGross)} Silver`;
      if (prevRrrPct) prevRrrPct.textContent = `${(item.rrr * 100).toFixed(1)}%`;
      if (prevRefundVal) {
        prevRefundVal.textContent = `-${formatSilver(prevRefundSilver)} Silver (${formatNumber(prevRefundUnits, 2)} unit)`;
      }
      if (prevNetVal) prevNetVal.textContent = `${formatSilver(item.effective_prev_cost)} Silver`;
    } else {
      if (stepPrevTable) stepPrevTable.style.display = 'none';
      if (noPrevBox) noPrevBox.style.display = 'block';
      if (stepPrevDesc) stepPrevDesc.textContent = 'Tidak memerlukan bahan tier sebelumnya (Base)';
      if (stepPrevNetTotal) stepPrevNetTotal.textContent = '0 Silver';
      if (prevNetVal) prevNetVal.textContent = '0 Silver';
    }

    // Step 3: Station Fee
    const nutrition = item.item_value * 0.1125;
    const stationTaxRate = nutrition > 0 ? (item.station_fee * 100) / nutrition : 0;

    if (stepStationFeeTotal) stepStationFeeTotal.textContent = `${formatSilver(item.station_fee)} Silver`;
    if (stationIvVal) stationIvVal.textContent = `${item.item_value}`;
    if (stationNutVal) stationNutVal.textContent = `${formatNumber(nutrition, 2)} Nutrition`;
    if (stationTaxRateVal) stationTaxRateVal.textContent = `${Math.round(stationTaxRate)} Silver / 100 Nut`;
    if (stationFeeVal) stationFeeVal.textContent = `${formatSilver(item.station_fee)} Silver`;

    // Step 4: Total Craft Cost
    if (totalCraftCostVal) totalCraftCostVal.textContent = `${formatSilver(item.total_craft_cost)} Silver`;
    if (craftCostEquation) {
      craftCostEquation.textContent = `${formatSilver(item.effective_raw_cost)} (Raw) + ${formatSilver(item.effective_prev_cost)} (Prev) + ${formatSilver(item.station_fee)} (Fee) = ${formatSilver(item.total_craft_cost)} Silver`;
    }

    // Step 5: Sales & Market Taxes
    const taxRatePct = item.gross_revenue > 0 ? (item.sales_tax / item.gross_revenue) * 100 : 0;
    const setupRatePct = item.gross_revenue > 0 ? (item.setup_fee / item.gross_revenue) * 100 : 0;

    if (stepNetRevTotal) stepNetRevTotal.textContent = `${formatSilver(item.net_revenue)} Silver`;
    if (marketSellPriceVal) marketSellPriceVal.textContent = `${formatSilver(item.sell_price, 0)} Silver`;
    if (marketTaxPct) marketTaxPct.textContent = `${taxRatePct.toFixed(1)}%`;
    if (marketTaxVal) marketTaxVal.textContent = `-${formatSilver(item.sales_tax)} Silver`;
    if (marketSetupPct) marketSetupPct.textContent = `${setupRatePct.toFixed(1)}%`;
    if (marketSetupVal) marketSetupVal.textContent = `-${formatSilver(item.setup_fee)} Silver`;
    if (marketNetRevenueVal) marketNetRevenueVal.textContent = `${formatSilver(item.net_revenue)} Silver`;

    // Step 6: Profit & Focus Efficiency
    const profitSign = item.profit_without_focus >= 0 ? '+' : '';
    const focusSign = item.profit_with_focus >= 0 ? '+' : '';
    const deltaSign = item.focus_profit_delta >= 0 ? '+' : '';

    if (stepSpfTotal) stepSpfTotal.textContent = `${item.silver_per_focus.toFixed(1)} SPF`;
    if (profitNoFocusVal) {
      profitNoFocusVal.textContent = `${profitSign}${formatSilver(item.profit_without_focus)} Silver`;
      profitNoFocusVal.style.color = item.profit_without_focus >= 0 ? 'var(--accent-mint)' : 'var(--accent-danger)';
    }
    if (profitMarginVal) {
      profitMarginVal.textContent = `Margin: ${item.profit_margin_pct.toFixed(1)}%`;
    }
    if (profitWithFocusVal) {
      profitWithFocusVal.textContent = `${focusSign}${formatSilver(item.profit_with_focus)} Silver`;
    }
    if (profitDeltaVal) {
      profitDeltaVal.textContent = `${deltaSign}${formatSilver(item.focus_profit_delta)} Silver bonus`;
    }
    if (focusCostVal) focusCostVal.textContent = `${item.actual_focus_cost} FP`;
    if (focusBaseVal) focusBaseVal.textContent = `Base: ${item.base_focus_cost} FP`;
    if (spfVal) spfVal.textContent = `${item.silver_per_focus.toFixed(1)} Silver/FP`;
    if (dailyFocusVal) {
      dailyFocusVal.textContent = `${profitSign}${formatSilver(item.daily_focus_silver, 0)} Silver / hari`;
    }
  }

  function generateDiscordMarkdown(item: RefiningMatrixItem): string {
    const tierEnc = `T${item.tier}.${item.enchantment}`;
    const displayName = getItemDisplayName(item.commodity, item.tier, item.enchantment);
    const rawDisplayName = getRawDisplayName(item.commodity, item.tier, item.enchantment);
    const prevDisplayName = getPrevDisplayName(item.commodity, item.tier, item.enchantment);

    const rawGross = item.raw_amount * item.raw_price;
    const rawRefundUnits = item.raw_amount * item.rrr;
    const rawRefundSilver = rawGross * item.rrr;

    const nutrition = item.item_value * 0.1125;
    const stationTaxRate = nutrition > 0 ? (item.station_fee * 100) / nutrition : 0;
    const taxRatePct = item.gross_revenue > 0 ? (item.sales_tax / item.gross_revenue) * 100 : 0;
    const setupRatePct = item.gross_revenue > 0 ? (item.setup_fee / item.gross_revenue) * 100 : 0;

    const prevBlock = item.prev_refined_amount > 0
      ? `2. BAHAN OLAHAN TIER SEBELUMNYA (PREV TIER):
   • ${item.prev_refined_amount}x ${prevDisplayName} [${item.prev_refined_item_id}]
   • Biaya Acuan (${item.is_chained ? 'Chained Craft' : 'Pasar'}): ${formatSilver(item.prev_refined_price, 0)} Silver / unit
   • Biaya Kotor: ${formatSilver(item.prev_refined_amount * item.prev_refined_price)} Silver
   • RRR Refund (${(item.rrr * 100).toFixed(1)}%): -${formatSilver(item.prev_refined_amount * item.prev_refined_price * item.rrr)} Silver (${formatNumber(item.prev_refined_amount * item.rrr, 2)} unit)
