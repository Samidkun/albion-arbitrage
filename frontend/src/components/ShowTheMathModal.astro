---
// ShowTheMathModal.astro - "Show the Math" Step-by-Step Calculation Audit Modal
---

<div
  id="math-modal-backdrop"
  class="modal-backdrop modal-hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-item-name"
>
  <div class="modal-card" id="math-modal-card">
    <!-- Modal Header -->
    <header class="modal-header">
      <div class="modal-header-info">
        <div class="modal-badge-row">
          <span id="modal-tier-badge" class="tier-pill">T6.1</span>
          <span id="modal-city-badge" class="city-pill">Fort Sterling (Bonus City)</span>
          <span id="modal-rrr-badge" class="rrr-pill">36.7% RRR</span>
          <span id="modal-chained-badge" class="chained-pill" style="display: none;">Chained Craft</span>
        </div>
        <h2 id="modal-item-name" class="modal-title">Bloodoak Planks (.1)</h2>
        <div class="modal-subtitle">
          <span id="modal-item-id" class="item-id-mono">T6_PLANKS_LEVEL1@1</span>
          <span class="sub-sep">•</span>
          <span id="modal-commodity-name">Wood</span>
          <span class="sub-sep">•</span>
          <span id="modal-age-caption" class="freshness-sub">Fresh (&lt; 15m)</span>
        </div>
      </div>
      <button
        type="button"
        id="modal-close-btn"
        class="close-btn"
        aria-label="Tutup Rincian Kalkulasi"
        title="Tutup (Esc)"
      >
        ✕
      </button>
    </header>

    <!-- Modal Body (Audit Steps) -->
    <div class="modal-body">
      <!-- Step 1: Raw Material Breakdown -->
      <section class="audit-step" aria-labelledby="step-1-title">
        <div class="step-header">
          <div class="step-header-left">
            <span class="step-num-badge">01</span>
            <div>
              <h3 id="step-1-title" class="step-title">BAHAN MENTAH (RAW MATERIAL)</h3>
              <p class="step-desc" id="step-raw-desc">4x T6_WOOD_LEVEL1@1</p>
            </div>
          </div>
          <div class="step-header-right">
            <span class="step-net-label">Net Raw Cost</span>
            <span class="step-net-val tabular-figures" id="step-raw-net-total">0 Silver</span>
          </div>
        </div>
        <div class="step-table">
          <div class="audit-row">
            <span class="label">Kebutuhan Dasar (Base Required)</span>
            <span class="val tabular-figures" id="raw-amount-val">4 unit</span>
          </div>
          <div class="audit-row">
            <span class="label">Harga Beli Pasar per Unit (Unit Price)</span>
            <span class="val tabular-figures" id="raw-price-val">420 Silver</span>
          </div>
          <div class="audit-row">
            <span class="label">Biaya Kotor Bahan Mentah (Gross Cost)</span>
            <span class="val tabular-figures" id="raw-gross-val">1,680 Silver</span>
          </div>
          <div class="audit-row discount-row">
            <span class="label">Refund Bahan RRR (<span id="raw-rrr-pct">36.7%</span>)</span>
            <span class="val tabular-figures refund-text" id="raw-refund-val">-616.56 Silver (1.47 unit)</span>
          </div>
          <div class="audit-row subtotal-row">
            <span class="label">Biaya Bersih Bahan Mentah (Net Raw Cost)</span>
            <span class="val tabular-figures highlight-val" id="raw-net-val">1,063.44 Silver</span>
          </div>
        </div>
      </section>

      <!-- Step 2: Previous Tier Refined Material Breakdown -->
      <section class="audit-step" aria-labelledby="step-2-title">
        <div class="step-header">
          <div class="step-header-left">
            <span class="step-num-badge">02</span>
            <div>
              <h3 id="step-2-title" class="step-title">BAHAN OLAHAN TIER SEBELUMNYA (PREV TIER)</h3>
              <p class="step-desc" id="step-prev-desc">1x T5_PLANKS_LEVEL1@1</p>
            </div>
          </div>
          <div class="step-header-right">
            <span class="step-net-label">Net Prev Cost</span>
            <span class="step-net-val tabular-figures" id="step-prev-net-total">0 Silver</span>
          </div>
        </div>
        <div class="step-table" id="step-prev-table">
          <div class="audit-row">
            <span class="label">Kebutuhan Olahan T-1 (Base Required)</span>
            <span class="val tabular-figures" id="prev-amount-val">1 unit</span>
          </div>
          <div class="audit-row">
            <span class="label">Harga Acuan (<span id="prev-price-source">Harga Pasar</span>)</span>
            <span class="val tabular-figures" id="prev-price-val">760 Silver</span>
          </div>
          <div class="audit-row">
            <span class="label">Biaya Kotor Olahan T-1 (Gross Cost)</span>
            <span class="val tabular-figures" id="prev-gross-val">760 Silver</span>
          </div>
          <div class="audit-row discount-row">
            <span class="label">Refund Bahan RRR (<span id="prev-rrr-pct">36.7%</span>)</span>
            <span class="val tabular-figures refund-text" id="prev-refund-val">-278.92 Silver (0.37 unit)</span>
          </div>
          <div class="audit-row subtotal-row">
            <span class="label">Biaya Bersih Olahan T-1 (Net Prev Cost)</span>
            <span class="val tabular-figures highlight-val" id="prev-net-val">481.08 Silver</span>
          </div>
        </div>
        <div class="no-prev-box" id="no-prev-box" style="display: none;">
          <span>Resep Tier dasar ini tidak membutuhkan olahan tier sebelumnya.</span>
        </div>
      </section>

      <!-- Step 3: Station Nutrition Fee Breakdown -->
      <section class="audit-step" aria-labelledby="step-3-title">
        <div class="step-header">
          <div class="step-header-left">
            <span class="step-num-badge">03</span>
            <div>
              <h3 id="step-3-title" class="step-title">ONGKOS TUKANG TEMPA (STATION NUTRITION FEE)</h3>
              <p class="step-desc">Formula Resmi Albion: IV × 0.1125 × (Tax / 100)</p>
            </div>
          </div>
          <div class="step-header-right">
            <span class="step-net-label">Total Station Fee</span>
            <span class="step-net-val tabular-figures" id="step-station-fee-total">0 Silver</span>
          </div>
        </div>
        <div class="step-table">
          <div class="audit-row">
            <span class="label">Nilai Item Dasar (Item Value / IV)</span>
            <span class="val tabular-figures" id="station-iv-val">128</span>
          </div>
          <div class="audit-row">
            <span class="label">Konsumsi Nutrisi Tukang (IV × 0.1125)</span>
            <span class="val tabular-figures" id="station-nut-val">14.40 Nutrition</span>
          </div>
          <div class="audit-row">
            <span class="label">Tarif Pajak Tukang (Station User Fee)</span>
            <span class="val tabular-figures" id="station-tax-rate-val">600 Silver / 100 Nut</span>
          </div>
          <div class="audit-row subtotal-row">
            <span class="label">Total Ongkos Sewa Tukang (Station Fee)</span>
            <span class="val tabular-figures highlight-val" id="station-fee-val">86.40 Silver</span>
          </div>
        </div>
      </section>

      <!-- Step 4: Total Craft Cost Summary -->
      <section class="audit-step total-step" aria-labelledby="step-4-title">
        <div class="step-header">
          <div class="step-header-left">
            <span class="step-num-badge accent">04</span>
            <div>
              <h3 id="step-4-title" class="step-title">TOTAL MODAL PRODUKSI (TOTAL CRAFT COST)</h3>
              <p class="step-desc">Net Raw Cost + Net Prev Cost + Station Fee</p>
            </div>
          </div>
          <div class="step-header-right">
            <span class="step-net-label">Biaya Pokok per Unit</span>
            <span class="step-grand-val tabular-figures" id="total-craft-cost-val">1,630.92 Silver</span>
          </div>
        </div>
        <div class="formula-banner">
          <span class="formula-code tabular-figures" id="craft-cost-equation">
            1,063.44 (Raw) + 481.08 (Prev) + 86.40 (Fee) = 1,630.92 Silver
          </span>
        </div>
      </section>

      <!-- Step 5: Sales & Market Taxes Breakdown -->
      <section class="audit-step" aria-labelledby="step-5-title">
        <div class="step-header">
          <div class="step-header-left">
            <span class="step-num-badge">05</span>
            <div>
              <h3 id="step-5-title" class="step-title">PENJUALAN & PAJAK PASAR (SALES & MARKET TAXES)</h3>
              <p class="step-desc">Target Sell Price & Market Deductions</p>
            </div>
          </div>
          <div class="step-header-right">
            <span class="step-net-label">Net Revenue</span>
            <span class="step-net-val tabular-figures" id="step-net-rev-total">0 Silver</span>
          </div>
        </div>
        <div class="step-table">
          <div class="audit-row">
            <span class="label">Harga Jual Target (Target Sell Price)</span>
            <span class="val tabular-figures" id="market-sell-price-val">2,450 Silver</span>
          </div>
          <div class="audit-row fee-row">
            <span class="label">Pajak Penjualan / Sales Tax (<span id="market-tax-pct">4.0%</span>)</span>
            <span class="val tabular-figures fee-text" id="market-tax-val">-98.00 Silver</span>
          </div>
          <div class="audit-row fee-row">
            <span class="label">Biaya Pasang Order / Setup Fee (<span id="market-setup-pct">2.5%</span>)</span>
            <span class="val tabular-figures fee-text" id="market-setup-val">-61.25 Silver</span>
          </div>
          <div class="audit-row subtotal-row">
            <span class="label">Pendapatan Bersih Penjual (Net Revenue)</span>
            <span class="val tabular-figures highlight-val" id="market-net-revenue-val">2,290.75 Silver</span>
          </div>
        </div>
      </section>

      <!-- Step 6: Profit & Focus Efficiency Breakdown -->
      <section class="audit-step focus-step" aria-labelledby="step-6-title">
        <div class="step-header">
          <div class="step-header-left">
            <span class="step-num-badge focus">06</span>
            <div>
              <h3 id="step-6-title" class="step-title">KEUNTUNGAN & EFISIENSI FOCUS (PROFIT & SPF)</h3>
              <p class="step-desc">Perbandingan Profit Standar vs Focus (53.9% RRR)</p>
            </div>
          </div>
          <div class="step-header-right">
            <span class="step-net-label">Silver per Focus</span>
            <span class="spf-badge-val tabular-figures" id="step-spf-total">54.2 SPF</span>
          </div>
        </div>
        <div class="profit-grid">
          <div class="profit-card">
            <span class="profit-card-label">PROFIT TANPA FOCUS</span>
            <span class="profit-card-value tabular-figures" id="profit-no-focus-val">+659.83 Silver</span>
            <span class="profit-card-sub" id="profit-margin-val">Margin: 40.5%</span>
          </div>
          <div class="profit-card">
            <span class="profit-card-label">PROFIT DENGAN FOCUS (53.9% RRR)</span>
            <span class="profit-card-value tabular-figures accent-mint" id="profit-with-focus-val">+1,147.20 Silver</span>
            <span class="profit-card-sub" id="profit-delta-val">+487.37 Silver bonus</span>
          </div>
          <div class="profit-card">
            <span class="profit-card-label">FOCUS POINT DIPERLUKAN</span>
            <span class="profit-card-value tabular-figures" id="focus-cost-val">450 FP</span>
            <span class="profit-card-sub" id="focus-base-val">Base: 450 FP</span>
          </div>
          <div class="profit-card">
            <span class="profit-card-label">SILVER PER FOCUS (SPF)</span>
            <span class="profit-card-value tabular-figures accent-lime" id="spf-val">54.2 Silver/FP</span>
            <span class="profit-card-sub">Delta Profit / Focus Cost</span>
          </div>
          <div class="profit-card full-width">
            <div class="daily-yield-left">
              <span class="profit-card-label">ESTIMASI SILVER DARI 10,000 FOCUS HARIAN</span>
              <span class="daily-yield-val tabular-figures accent-lime" id="daily-focus-val">+542,000 Silver / hari</span>
            </div>
            <span class="daily-yield-sub">Yield jika 10k focus harian dialokasikan penuh ke resep ini</span>
          </div>
        </div>
      </section>
    </div>

    <!-- Modal Footer -->
    <footer class="modal-footer">
      <div class="footer-note">
        <span class="note-icon">📋</span>
        <span>Format Discord otomatis disesuaikan untuk perencanaan guild & posting order.</span>
      </div>
      <div class="footer-buttons">
        <button type="button" id="copy-discord-btn" class="btn-copy-discord">
          <svg class="btn-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
          </svg>
          <span id="copy-discord-text">Salin Ringkasan (Discord/Guild)</span>
        </button>
        <button type="button" id="modal-close-footer-btn" class="btn-modal-close">
          Tutup
        </button>
      </div>
    </footer>
  </div>
</div>

<style>
  /* Modal Backdrop */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 12, 16, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 1.25rem;
    opacity: 1;
    transition: opacity 0.18s ease-in-out;
  }

  .modal-backdrop.modal-hidden {
    opacity: 0;
    pointer-events: none;
    display: none;
  }

  /* Modal Card */
  .modal-card {
    width: 100%;
    max-width: 740px;
    max-height: 92vh;
    background-color: var(--surface-primary);
    border: 1px solid var(--border-hairline);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
    animation: modal-enter 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modal-enter {
    from {
      transform: scale(0.97) translateY(8px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  /* Header */
  .modal-header {
    background-color: var(--surface-elevated);
    border-bottom: 1px solid var(--border-hairline);
    padding: 1.1rem 1.4rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .modal-header-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .modal-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tier-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background-color: var(--surface-primary);
    border: 1px solid #3b82f6;
    color: #60a5fa;
  }
  .tier-pill.tier-t4 { border-color: #3b82f6; color: #60a5fa; }
  .tier-pill.tier-t5 { border-color: #ef4444; color: #f87171; }
  .tier-pill.tier-t6 { border-color: #f97316; color: #fb923c; }
  .tier-pill.tier-t7 { border-color: #eab308; color: #fde047; }
  .tier-pill.tier-t8 { border-color: #e2e8f0; color: #ffffff; }

  .city-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background-color: rgba(199, 245, 59, 0.1);
    border: 1px solid rgba(199, 245, 59, 0.3);
    color: var(--accent-primary);
  }

  .rrr-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background-color: rgba(78, 229, 182, 0.1);
    border: 1px solid rgba(78, 229, 182, 0.3);
    color: var(--accent-mint);
  }

  .chained-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background-color: rgba(157, 165, 180, 0.12);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
  }

  .modal-title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .modal-subtitle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .item-id-mono {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .sub-sep {
    color: var(--border-hairline);
  }

  .freshness-sub {
    color: var(--accent-mint);
    font-weight: 600;
  }

  .close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background-color: var(--surface-primary);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    font-size: 1rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .close-btn:hover {
    background-color: var(--border-hairline);
    color: var(--text-primary);
  }

  /* Modal Body */
  .modal-body {
    overflow-y: auto;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  /* Step Cards */
  .audit-step {
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    overflow: hidden;
  }

  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background-color: rgba(22, 24, 28, 0.4);
    border-bottom: 1px solid var(--border-hairline);
    gap: 0.75rem;
  }

  .step-header-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .step-num-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-muted);
    background-color: var(--surface-primary);
    border: 1px solid var(--border-hairline);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .step-num-badge.accent {
    color: var(--accent-primary);
    border-color: rgba(199, 245, 59, 0.3);
  }

  .step-num-badge.focus {
    color: var(--accent-mint);
    border-color: rgba(78, 229, 182, 0.3);
  }

  .step-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .step-desc {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 0.1rem;
  }

  .step-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }

  .step-net-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .step-net-val {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .step-grand-val {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--accent-primary);
  }

  .spf-badge-val {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--accent-primary);
  }

  /* Step Table */
  .step-table {
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .audit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0;
    font-size: 0.78rem;
    gap: 0.5rem;
  }

  .audit-row .label {
    color: var(--text-secondary);
  }

  .audit-row .val {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }

  .audit-row.discount-row .label {
    color: var(--accent-mint);
  }

  .audit-row.discount-row .refund-text {
    color: var(--accent-mint);
    font-weight: 700;
  }

  .audit-row.fee-row .fee-text {
    color: var(--accent-danger);
    font-weight: 700;
  }

  .audit-row.subtotal-row {
    border-top: 1px dashed var(--border-hairline);
    margin-top: 0.25rem;
    padding-top: 0.45rem;
  }

  .audit-row.subtotal-row .label {
    font-weight: 700;
    color: var(--text-primary);
  }

  .audit-row.subtotal-row .highlight-val {
    font-weight: 800;
    color: var(--text-primary);
  }

  .no-prev-box {
    padding: 0.85rem 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Step 4 Formula Banner */
  .total-step {
    border-color: rgba(199, 245, 59, 0.25);
  }

  .formula-banner {
    padding: 0.75rem 1rem;
    background-color: rgba(199, 245, 59, 0.04);
    border-top: 1px solid var(--border-hairline);
  }

  .formula-code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-primary);
    word-break: break-all;
  }

  /* Step 6 Profit Grid */
  .profit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    padding: 0.85rem 1rem;
  }

  .profit-card {
    background-color: var(--surface-primary);
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
