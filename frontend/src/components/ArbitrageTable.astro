  // Helper Functions
  function parseDurationSeconds(age: number | string | undefined): number {
    if (age === undefined || age === null) return 0;
    if (typeof age === 'number') {
      if (age > 1_000_000_000) {
        return Math.round(age / 1_000_000_000);
      }
      return Math.round(age);
    }
    if (typeof age === 'string') {
      let totalSec = 0;
      const hoursMatch = age.match(/(\d+)h/);
      const minsMatch = age.match(/(\d+)m/);
      const secsMatch = age.match(/(\d+)s/);
      if (hoursMatch) totalSec += parseInt(hoursMatch[1], 10) * 3600;
      if (minsMatch) totalSec += parseInt(minsMatch[1], 10) * 60;
      if (secsMatch) totalSec += parseInt(secsMatch[1], 10);
      if (totalSec > 0) return totalSec;
      const parsed = parseFloat(age);
      if (!isNaN(parsed)) {
        if (parsed > 1_000_000_000) return Math.round(parsed / 1_000_000_000);
        return Math.round(parsed);
      }
    }
    return 0;
  }

  function formatAgeBadge(seconds: number, isStaleFlag?: boolean): { text: string; cssClass: 'fresh' | 'aging' | 'stale' } {
    if (isStaleFlag || seconds > 3600) {
      return { text: '>60m STALE', cssClass: 'stale' };
    }
    if (seconds < 60) {
      return { text: 'Just now', cssClass: 'fresh' };
    }
    const mins = Math.floor(seconds / 60);
    if (mins < 15) {
      return { text: `${mins}m ago`, cssClass: 'fresh' };
    }
    return { text: `${mins}m ago`, cssClass: 'aging' };
  }

  function getLiquidityBadge(vol: number, isIlliquid: boolean): { text: string; cssClass: string } {
    if (isIlliquid || vol < 15) {
      return { text: 'Illiquid', cssClass: 'liq-low' };
    }
    if (vol >= 500) {
      return { text: 'High', cssClass: 'liq-high' };
    }
    return { text: 'Med', cssClass: 'liq-med' };
  }

  function getRouteRisk(route: ArbitrageRoute): { text: string; cssClass: 'safe' | 'aging' | 'stale' | 'illiquid' } {
    const buySec = parseDurationSeconds(route.buy_price_age);
    const sellSec = parseDurationSeconds(route.sell_price_age);

    const isStale = route.is_stale_route || route.is_buy_stale || route.is_sell_stale || buySec > 3600 || sellSec > 3600;
    if (isStale) {
      return { text: 'STALE QUOTE', cssClass: 'stale' };
    }

    if (route.is_illiquid || route.traded_volume_24h < 15) {
      return { text: 'ILLIQUID', cssClass: 'illiquid' };
    }

    if (buySec > 900 || sellSec > 900) {
      return { text: 'AGING CAUTION', cssClass: 'aging' };
    }

    return { text: 'SAFE ROUTE', cssClass: 'safe' };
  }

  function parseItemInfo(itemId: string) {
    const match = itemId.match(/^T(\d+)_([A-Z]+)(?:_LEVEL(\d+)@\d+)?$/);
    if (!match) {
      return {
        tier: 4,
        enchantment: 0,
        tierEnc: 'T4.0',
        name: itemId,
        commodity: 'wood',
        isRefined: true
      };
    }

    const tier = parseInt(match[1], 10);
    const resourceType = match[2];
    const enchantment = match[3] ? parseInt(match[3], 10) : 0;
    const tierEnc = enchantment > 0 ? `T${tier}.${enchantment}` : `T${tier}.0`;

    let commodity = 'wood';
    let isRefined = true;

    switch (resourceType) {
      case 'WOOD':
        commodity = 'wood';
        isRefined = false;
        break;
      case 'PLANKS':
        commodity = 'wood';
        isRefined = true;
        break;
      case 'ORE':
        commodity = 'ore';
        isRefined = false;
        break;
      case 'METALBAR':
        commodity = 'ore';
        isRefined = true;
        break;
      case 'FIBER':
        commodity = 'fiber';
        isRefined = false;
        break;
      case 'CLOTH':
        commodity = 'fiber';
        isRefined = true;
        break;
      case 'HIDE':
        commodity = 'hide';
        isRefined = false;
        break;
      case 'LEATHER':
        commodity = 'hide';
        isRefined = true;
        break;
      case 'ROCK':
        commodity = 'stone';
        isRefined = false;
        break;
      case 'STONEBLOCK':
        commodity = 'stone';
        isRefined = true;
        break;
    }

    const names = COMMODITY_NAMES[commodity]?.[tier];
    let baseName = itemId;
    if (names) {
      baseName = isRefined ? names.refined : names.raw;
    }
    if (enchantment > 0 && !baseName.includes(`.${enchantment}`)) {
      baseName = `${baseName} (.${enchantment})`;
    }

    return {
      tier,
      enchantment,
      tierEnc,
      name: baseName,
      commodity,
      isRefined
    };
  }

  function formatSilver(val: number): string {
    return Math.round(val).toLocaleString('id-ID');
  }

  function recalculateRouteTaxes(route: ArbitrageRoute, channel: string, isPremium: boolean): ArbitrageRoute {
    let salesTaxRate = 0.04;
    let setupFeeRate = 0.025;

    if (channel === 'direct') {
      salesTaxRate = 0;
      setupFeeRate = 0;
    } else if (channel === 'instant_buy') {
      salesTaxRate = isPremium ? 0.04 : 0.08;
      setupFeeRate = 0;
    } else {
      salesTaxRate = isPremium ? 0.04 : 0.08;
      setupFeeRate = 0.025;
    }

    const grossRevenue = route.sell_price;
    const salesTax = grossRevenue * salesTaxRate;
    const setupFee = grossRevenue * setupFeeRate;
    const netRevenue = grossRevenue - salesTax - setupFee;
    const netProfit = netRevenue - route.buy_price;
    const netMargin = route.buy_price > 0 ? (netProfit / route.buy_price) * 100 : 0;

    return {
      ...route,
      tax_channel: channel,
      sales_tax_rate: salesTaxRate,
      setup_fee_rate: setupFeeRate,
      gross_revenue: grossRevenue,
      net_revenue: netRevenue,
      net_profit_per_unit: netProfit,
      net_margin_percent: netMargin
    };
  }

  // Component State
  let state: ArbitrageState = {
    region: localStorage.getItem('albionflow_region') || 'asia',
    originCity: localStorage.getItem('albionflow_arb_origin') || 'ALL',
    targetCity: localStorage.getItem('albionflow_arb_target') || 'ALL',
    minProfit: parseInt(localStorage.getItem('albionflow_arb_min_profit') || '0', 10) || 0,
    taxChannel: localStorage.getItem('albionflow_arb_tax_channel') || 'sell_order',
    premium: localStorage.getItem('albionflow_arb_premium') !== 'false',
    excludeStale: localStorage.getItem('albionflow_arb_exclude_stale') !== 'false',
    excludeIlliquid: localStorage.getItem('albionflow_arb_exclude_illiquid') !== 'false',
    sortKey: 'profit',
    sortOrder: 'desc'
  };

  let rawRoutes: ArbitrageRoute[] = [];

  // DOM references
  let tableBody: HTMLTableSectionElement | null = null;
  let emptyState: HTMLElement | null = null;
  let routesCountBadge: HTMLElement | null = null;
  let statusBadge: HTMLElement | null = null;
  let statusLabel: HTMLElement | null = null;
  let originSelect: HTMLSelectElement | null = null;
  let targetSelect: HTMLSelectElement | null = null;
  let minProfitInput: HTMLInputElement | null = null;
  let taxChannelSelect: HTMLSelectElement | null = null;
  let premiumToggleBtn: HTMLButtonElement | null = null;
  let premiumStatusLabel: HTMLElement | null = null;
  let excludeStaleCheck: HTMLInputElement | null = null;
  let excludeIlliquidCheck: HTMLInputElement | null = null;
  let swapBtn: HTMLButtonElement | null = null;
  let resetBtn: HTMLButtonElement | null = null;

  async function fetchArbitrageRoutes() {
    const url = new URL('http://localhost:8081/api/v1/arbitrage/routes');
    url.searchParams.set('region', state.region);
    url.searchParams.set('min_profit', state.minProfit.toString());
    url.searchParams.set('min_margin', '0');
    url.searchParams.set('exclude_stale', state.excludeStale ? 'true' : 'false');
    url.searchParams.set('exclude_illiquid', state.excludeIlliquid ? 'true' : 'false');
    url.searchParams.set('channel', state.taxChannel);
    url.searchParams.set('premium', state.premium ? 'true' : 'false');

    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 3000);
      const res = await fetch(url.toString(), { signal: controller.signal });
      clearTimeout(timeoutId);

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const data: ArbitrageRoute[] = await res.json();
      rawRoutes = data;
      updateStatusBadge(true, `Live API (${state.region.toUpperCase()})`);
    } catch (err) {
      // Backend unreachable or offline: compute with rich fallback sample data
      rawRoutes = FALLBACK_ROUTES_DATA.map((r) =>
        recalculateRouteTaxes(r, state.taxChannel, state.premium)
      );
      updateStatusBadge(false, `Offline Snapshot (${state.region.toUpperCase()})`);
    }

    renderTable();
  }

  function updateStatusBadge(isLive: boolean, text: string) {
    if (!statusBadge || !statusLabel) return;
    statusBadge.className = isLive ? 'source-status live' : 'source-status offline';
    statusLabel.textContent = text;
  }

  function renderTable() {
    if (!tableBody) return;

    // Filter routes according to current filters
    let filtered = rawRoutes.map((r) =>
      recalculateRouteTaxes(r, state.taxChannel, state.premium)
    ).filter((item) => {
      // Origin city
      if (state.originCity !== 'ALL' && item.origin_city.toLowerCase() !== state.originCity.toLowerCase()) {
        return false;
      }
      // Target city
      if (state.targetCity !== 'ALL' && item.target_city.toLowerCase() !== state.targetCity.toLowerCase()) {
        return false;
      }
      // Exclude Stale
      const buyAgeSec = parseDurationSeconds(item.buy_price_age);
      const sellAgeSec = parseDurationSeconds(item.sell_price_age);
      const isStale = item.is_stale_route || item.is_buy_stale || item.is_sell_stale || buyAgeSec > 3600 || sellAgeSec > 3600;
      if (state.excludeStale && isStale) {
        return false;
      }
      // Exclude Illiquid
      const isIlliquid = item.is_illiquid || item.traded_volume_24h < 15;
      if (state.excludeIlliquid && isIlliquid) {
        return false;
      }
      // Min Net Profit
      if (state.minProfit > 0 && item.net_profit_per_unit < state.minProfit) {
        return false;
      }
      return true;
    });

    // Sort routes
    filtered.sort((a, b) => {
      let valA = 0;
      let valB = 0;
      switch (state.sortKey) {
        case 'margin':
          valA = a.net_margin_percent;
          valB = b.net_margin_percent;
          break;
        case 'volume':
          valA = a.traded_volume_24h;
          valB = b.traded_volume_24h;
          break;
        case 'buy_price':
          valA = a.buy_price;
          valB = b.buy_price;
          break;
        case 'profit':
        default:
          valA = a.net_profit_per_unit;
          valB = b.net_profit_per_unit;
          break;
      }

      if (state.sortOrder === 'asc') {
        return valA > valB ? 1 : valA < valB ? -1 : 0;
      } else {
        return valA < valB ? 1 : valA > valB ? -1 : 0;
      }
    });

    // Update count badge
    if (routesCountBadge) {
      routesCountBadge.textContent = `${filtered.length} Routes`;
    }

    // Toggle empty state
    if (filtered.length === 0) {
      tableBody.innerHTML = '';
      if (emptyState) emptyState.style.display = 'block';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';

    // Render Rows HTML
    const htmlRows = filtered.map((item) => {
      const itemInfo = parseItemInfo(item.item_id);
      const buyAgeSec = parseDurationSeconds(item.buy_price_age);
      const sellAgeSec = parseDurationSeconds(item.sell_price_age);
      const buyAge = formatAgeBadge(buyAgeSec, item.is_buy_stale);
      const sellAge = formatAgeBadge(sellAgeSec, item.is_sell_stale);
      const liqBadge = getLiquidityBadge(item.traded_volume_24h, item.is_illiquid);
      const risk = getRouteRisk(item);

      const isProfitPositive = item.net_profit_per_unit >= 0;
      const profitClass = isProfitPositive ? 'positive' : 'negative';
      const profitSign = isProfitPositive ? '+' : '';

      const isMarginPositive = item.net_margin_percent >= 0;
      const marginClass = isMarginPositive ? 'positive' : 'negative';
      const marginSign = isMarginPositive ? '+' : '';

      const isOriginCaerleon = item.origin_city.toLowerCase() === 'caerleon';
      const isTargetCaerleon = item.target_city.toLowerCase() === 'caerleon';

      return `
        <tr data-item-id="${item.item_id}" data-origin="${item.origin_city}" data-target="${item.target_city}">
          <td class="td-tier">
            <span class="tier-badge tier-t${itemInfo.tier}">${itemInfo.tierEnc}</span>
          </td>
          <td class="td-item">
            <div class="item-cell">
              <span class="item-name">${itemInfo.name}</span>
              <span class="item-sub">${item.item_id}</span>
            </div>
          </td>
          <td class="td-route">
            <div class="route-wrapper">
              <span class="city-name origin-city ${isOriginCaerleon ? 'caerleon' : ''}">${item.origin_city}</span>
              <span class="route-arrow">➔</span>
              <span class="city-name target-city ${isTargetCaerleon ? 'caerleon' : ''}">${item.target_city}</span>
            </div>
          </td>
          <td class="td-buy num-cell-right">
            <div class="price-cell-wrapper">
              <span class="price-val tabular-figures">${formatSilver(item.buy_price)} <span class="silver-unit">Silver</span></span>
              <span class="age-badge ${buyAge.cssClass}"><span class="dot"></span>${buyAge.text}</span>
            </div>
          </td>
          <td class="td-sell num-cell-right">
            <div class="price-cell-wrapper">
              <span class="price-val tabular-figures">${formatSilver(item.sell_price)} <span class="silver-unit">Silver</span></span>
              <span class="age-badge ${sellAge.cssClass}"><span class="dot"></span>${sellAge.text}</span>
            </div>
          </td>
          <td class="td-profit num-cell-right">
            <span class="net-profit-val tabular-figures ${profitClass}">${profitSign}${formatSilver(item.net_profit_per_unit)} Silver</span>
          </td>
          <td class="td-margin num-cell-right">
            <span class="net-margin-val tabular-figures ${marginClass}">${marginSign}${item.net_margin_percent.toFixed(1)}%</span>
          </td>
          <td class="td-volume num-cell-right">
            <div class="volume-wrapper">
              <span class="volume-val tabular-figures">${formatSilver(item.traded_volume_24h)} unit/day</span>
              <span class="liq-badge ${liqBadge.cssClass}">${liqBadge.text}</span>
            </div>
          </td>
          <td class="td-risk">
            <span class="risk-tag ${risk.cssClass}">
              <span class="risk-dot"></span>
              ${risk.text}
            </span>
          </td>
        </tr>
      `;
    }).join('');

    tableBody.innerHTML = htmlRows;
    updateSortIndicators();
  }

  function updateSortIndicators() {
    const sortBtns = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
    sortBtns.forEach((btn) => {
      const key = btn.dataset.sort;
      const arrowSpan = btn.querySelector('.sort-arrow');
      if (key === state.sortKey) {
        btn.classList.add('active');
        if (arrowSpan) {
          arrowSpan.textContent = state.sortOrder === 'asc' ? '▲' : '▼';
        }
      } else {
        btn.classList.remove('active');
        if (arrowSpan) {
          arrowSpan.textContent = '';
        }
      }
    });

    const thElements = document.querySelectorAll<HTMLTableCellElement>('.sortable-th');
    thElements.forEach((th) => {
      const key = th.dataset.sortKey;
      const iconSpan = th.querySelector('.col-sort-icon');
      if (key === state.sortKey) {
        th.classList.add('active-sort');
        if (iconSpan) {
          iconSpan.textContent = state.sortOrder === 'asc' ? '▲' : '▼';
        }
      } else {
        th.classList.remove('active-sort');
        if (iconSpan) {
          iconSpan.textContent = '';
        }
      }
    });
  }

  function setSort(key: ArbitrageState['sortKey']) {
    if (state.sortKey === key) {
      state.sortOrder = state.sortOrder === 'asc' ? 'desc' : 'asc';
    } else {
      state.sortKey = key;
      state.sortOrder = key === 'buy_price' ? 'asc' : 'desc';
    }
    renderTable();
  }

  function saveFilterState() {
    localStorage.setItem('albionflow_arb_origin', state.originCity);
    localStorage.setItem('albionflow_arb_target', state.targetCity);
    localStorage.setItem('albionflow_arb_min_profit', state.minProfit.toString());
    localStorage.setItem('albionflow_arb_tax_channel', state.taxChannel);
    localStorage.setItem('albionflow_arb_premium', state.premium ? 'true' : 'false');
    localStorage.setItem('albionflow_arb_exclude_stale', state.excludeStale ? 'true' : 'false');
    localStorage.setItem('albionflow_arb_exclude_illiquid', state.excludeIlliquid ? 'true' : 'false');
  }

  function initArbitrageTable() {
    tableBody = document.getElementById('arbitrage-table-body') as HTMLTableSectionElement | null;
    emptyState = document.getElementById('arbitrage-empty-state');
    routesCountBadge = document.getElementById('routes-count-badge');
    statusBadge = document.getElementById('arbitrage-status-badge');
    statusLabel = document.getElementById('arbitrage-status-label');

    originSelect = document.getElementById('origin-city-select') as HTMLSelectElement | null;
    targetSelect = document.getElementById('target-city-select') as HTMLSelectElement | null;
    minProfitInput = document.getElementById('min-profit-input') as HTMLInputElement | null;
    taxChannelSelect = document.getElementById('tax-channel-select') as HTMLSelectElement | null;
    premiumToggleBtn = document.getElementById('premium-toggle-btn') as HTMLButtonElement | null;
    premiumStatusLabel = document.getElementById('premium-status-label');
    excludeStaleCheck = document.getElementById('exclude-stale-check') as HTMLInputElement | null;
    excludeIlliquidCheck = document.getElementById('exclude-illiquid-check') as HTMLInputElement | null;
    swapBtn = document.getElementById('swap-cities-btn') as HTMLButtonElement | null;
    resetBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement | null;

    // Apply initial state values to controls
    if (originSelect) originSelect.value = state.originCity;
    if (targetSelect) targetSelect.value = state.targetCity;
    if (minProfitInput) minProfitInput.value = state.minProfit.toString();
    if (taxChannelSelect) taxChannelSelect.value = state.taxChannel;
    if (excludeStaleCheck) excludeStaleCheck.checked = state.excludeStale;
    if (excludeIlliquidCheck) excludeIlliquidCheck.checked = state.excludeIlliquid;

    const updatePremiumUI = () => {
      if (!premiumToggleBtn || !premiumStatusLabel) return;
      if (state.premium) {
        premiumToggleBtn.classList.add('active');
        premiumToggleBtn.setAttribute('aria-checked', 'true');
        premiumStatusLabel.textContent = 'Premium Active (4% Tax)';
      } else {
        premiumToggleBtn.classList.remove('active');
        premiumToggleBtn.setAttribute('aria-checked', 'false');
        premiumStatusLabel.textContent = 'Non-Premium (8% Tax)';
      }
    };
    updatePremiumUI();

    // Event Listeners for controls
    originSelect?.addEventListener('change', () => {
      state.originCity = originSelect?.value || 'ALL';
      saveFilterState();
      renderTable();
    });

    targetSelect?.addEventListener('change', () => {
      state.targetCity = targetSelect?.value || 'ALL';
      saveFilterState();
      renderTable();
    });

    swapBtn?.addEventListener('click', () => {
      const temp = state.originCity;
      state.originCity = state.targetCity;
      state.targetCity = temp;
      if (originSelect) originSelect.value = state.originCity;
      if (targetSelect) targetSelect.value = state.targetCity;
      saveFilterState();
      renderTable();
    });

    minProfitInput?.addEventListener('input', () => {
      const val = parseInt(minProfitInput?.value || '0', 10);
      state.minProfit = isNaN(val) || val < 0 ? 0 : val;
      saveFilterState();
      renderTable();
    });

    taxChannelSelect?.addEventListener('change', () => {
      state.taxChannel = taxChannelSelect?.value || 'sell_order';
      saveFilterState();
      fetchArbitrageRoutes();
    });

    premiumToggleBtn?.addEventListener('click', () => {
      state.premium = !state.premium;
      updatePremiumUI();
      saveFilterState();
      fetchArbitrageRoutes();
    });

    excludeStaleCheck?.addEventListener('change', () => {
      state.excludeStale = excludeStaleCheck?.checked ?? true;
      saveFilterState();
      fetchArbitrageRoutes();
    });

    excludeIlliquidCheck?.addEventListener('change', () => {
      state.excludeIlliquid = excludeIlliquidCheck?.checked ?? true;
      saveFilterState();
      fetchArbitrageRoutes();
    });

    resetBtn?.addEventListener('click', () => {
      state.originCity = 'ALL';
      state.targetCity = 'ALL';
      state.minProfit = 0;
      state.taxChannel = 'sell_order';
      state.premium = true;
      state.excludeStale = true;
      state.excludeIlliquid = true;

      if (originSelect) originSelect.value = 'ALL';
      if (targetSelect) targetSelect.value = 'ALL';
      if (minProfitInput) minProfitInput.value = '0';
      if (taxChannelSelect) taxChannelSelect.value = 'sell_order';
      if (excludeStaleCheck) excludeStaleCheck.checked = true;
      if (excludeIlliquidCheck) excludeIlliquidCheck.checked = true;
      updatePremiumUI();

      saveFilterState();
      fetchArbitrageRoutes();
    });

    // Toolbar sorting buttons
    const sortBtns = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort as ArbitrageState['sortKey'];
        if (key) setSort(key);
      });
    });

    // Header click sorting
    const thElements = document.querySelectorAll<HTMLTableCellElement>('.sortable-th');
    thElements.forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.sortKey as ArbitrageState['sortKey'];
        if (key) setSort(key);
      });
    });

    // Listen to Region Switcher & Price Refresh events from Header
    window.addEventListener('albionflow:region-changed', (e: any) => {
      if (e.detail?.region) {
        state.region = e.detail.region.toLowerCase();
        fetchArbitrageRoutes();
      }
    });

    window.addEventListener('albionflow:prices-refreshed', () => {
      fetchArbitrageRoutes();
    });

    // Initial Fetch
    fetchArbitrageRoutes();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArbitrageTable);
  } else {
    initArbitrageTable();
  }
</script>
