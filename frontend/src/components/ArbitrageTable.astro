---
// ArbitrageTable.astro - Cross-City Hauling Arbitrage Matrix Component
// AlbionFlow Anti-UI-Slop High-Density Trade Route Scanner
---

<div class="arbitrage-matrix-container panel" id="arbitrage-matrix-container">
  <!-- Filter & Control Bar -->
  <div class="arbitrage-filter-bar">
    <!-- Row 1: Route & Profit Filter -->
    <div class="filter-row route-filter-row">
      <div class="filter-group">
        <label for="origin-city-select" class="filter-label">ORIGIN CITY:</label>
        <div class="select-wrapper">
          <select id="origin-city-select" class="custom-select" aria-label="Origin City">
            <option value="ALL" selected>All Origin Cities</option>
            <option value="Thetford">Thetford (Ore Hub)</option>
            <option value="Fort Sterling">Fort Sterling (Wood Hub)</option>
            <option value="Lymhurst">Lymhurst (Fiber Hub)</option>
            <option value="Bridgewatch">Bridgewatch (Stone Hub)</option>
            <option value="Martlock">Martlock (Hide Hub)</option>
            <option value="Caerleon">Caerleon (Red Zone Hub)</option>
          </select>
        </div>
      </div>

      <div class="swap-action-wrap">
        <button type="button" id="swap-cities-btn" class="swap-btn" title="Swap Origin and Target Cities">
          ⇄
        </button>
      </div>

      <div class="filter-group">
        <label for="target-city-select" class="filter-label">TARGET CITY:</label>
        <div class="select-wrapper">
          <select id="target-city-select" class="custom-select" aria-label="Target City">
            <option value="ALL" selected>All Target Cities</option>
            <option value="Caerleon">Caerleon (Red Zone Hub)</option>
            <option value="Thetford">Thetford</option>
            <option value="Fort Sterling">Fort Sterling</option>
            <option value="Lymhurst">Lymhurst</option>
            <option value="Bridgewatch">Bridgewatch</option>
            <option value="Martlock">Martlock</option>
          </select>
        </div>
      </div>

      <div class="filter-group profit-input-group">
        <label for="min-profit-input" class="filter-label">MIN NET PROFIT:</label>
        <div class="input-with-unit">
          <input
            type="number"
            id="min-profit-input"
            class="custom-num-input tabular-figures"
            min="0"
            step="100"
            value="0"
            placeholder="0"
            aria-label="Minimum Net Profit Silver"
          />
          <span class="input-unit">Silver</span>
        </div>
      </div>

      <div class="filter-group reset-group">
        <button type="button" id="reset-filters-btn" class="reset-btn" title="Reset all filters to defaults">
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Row 2: Tax Mechanism & Risk Thresholds -->
    <div class="filter-row tax-risk-row">
      <div class="filter-group">
        <label for="tax-channel-select" class="filter-label">TAX CHANNEL:</label>
        <div class="select-wrapper">
          <select id="tax-channel-select" class="custom-select" aria-label="Tax Channel">
            <option value="sell_order" selected>Sell Order (2.5% fee + 4% tax)</option>
            <option value="instant_buy">Instant Buy Order (4% tax)</option>
            <option value="direct">Direct Trade / Discord (0% tax)</option>
          </select>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">PREMIUM STATUS:</span>
        <button
          type="button"
          id="premium-toggle-btn"
          class="toggle-btn active"
          role="switch"
          aria-checked="true"
        >
          <span class="toggle-indicator"></span>
          <span id="premium-status-label" class="tabular-figures">Premium Active (4% Tax)</span>
        </button>
      </div>

      <div class="filter-group checkboxes-group">
        <label class="custom-checkbox-label">
          <input type="checkbox" id="exclude-stale-check" checked />
          <span class="checkbox-text">Exclude Stale (&gt;60m)</span>
        </label>

        <label class="custom-checkbox-label">
          <input type="checkbox" id="exclude-illiquid-check" checked />
          <span class="checkbox-text">Exclude Illiquid (&lt;15/day)</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Table Toolbar -->
  <div class="table-toolbar">
    <div class="toolbar-left">
      <div class="table-headline">
        <span class="toolbar-title">HAULING MATRIX</span>
        <span class="count-badge tabular-figures" id="routes-count-badge">0 Routes</span>
      </div>
      <div class="source-status" id="arbitrage-status-badge">
        <span class="status-dot"></span>
        <span class="status-label" id="arbitrage-status-label">Connecting to Scanner...</span>
      </div>
    </div>

    <div class="toolbar-right">
      <div class="sort-controls">
        <span class="sort-label">SORT BY:</span>
        <div class="sort-buttons" role="group" aria-label="Sort Options">
          <button type="button" class="sort-btn active" data-sort="profit" title="Sort by Net Unit Profit">
            Profit <span class="sort-arrow" id="sort-profit-arrow">▼</span>
          </button>
          <button type="button" class="sort-btn" data-sort="margin" title="Sort by Net Margin Percent">
            Margin % <span class="sort-arrow" id="sort-margin-arrow"></span>
          </button>
          <button type="button" class="sort-btn" data-sort="volume" title="Sort by 24h Traded Volume">
            Volume <span class="sort-arrow" id="sort-volume-arrow"></span>
          </button>
          <button type="button" class="sort-btn" data-sort="buy_price" title="Sort by Buy Price at Origin">
            Buy Price <span class="sort-arrow" id="sort-buy-price-arrow"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scrollable Matrix Table -->
  <div class="table-scroll-wrapper">
    <table class="arbitrage-table" id="arbitrage-routes-table" aria-label="Arbitrage Routes Table">
      <thead>
        <tr>
          <th scope="col" class="th-tier">TIER / ENC</th>
          <th scope="col" class="th-item">ITEM NAME</th>
          <th scope="col" class="th-route">ROUTE (ORIGIN ➔ TARGET)</th>
          <th scope="col" class="th-buy sortable-th" data-sort-key="buy_price">
            <span class="th-content">BUY @ ORIGIN <span class="col-sort-icon" id="col-sort-buy_price"></span></span>
          </th>
          <th scope="col" class="th-sell">
            <span class="th-content">SELL @ TARGET</span>
          </th>
          <th scope="col" class="th-profit sortable-th active-sort" data-sort-key="profit">
            <span class="th-content">NET UNIT PROFIT <span class="col-sort-icon" id="col-sort-profit">▼</span></span>
          </th>
          <th scope="col" class="th-margin sortable-th" data-sort-key="margin">
            <span class="th-content">NET MARGIN % <span class="col-sort-icon" id="col-sort-margin"></span></span>
          </th>
          <th scope="col" class="th-volume sortable-th" data-sort-key="volume">
            <span class="th-content">TARGET 24H VOLUME <span class="col-sort-icon" id="col-sort-volume"></span></span>
          </th>
          <th scope="col" class="th-risk">RISK TAG</th>
        </tr>
      </thead>
      <tbody id="arbitrage-table-body">
        <tr class="loading-row">
          <td colspan="9" class="loading-cell">
            <div class="loading-spinner-wrap">
              <span class="loading-spinner"></span>
              <span>Scanning cross-city arbitrage routes...</span>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Empty State Banner -->
  <div class="empty-state" id="arbitrage-empty-state" style="display: none;">
    <div class="empty-icon">⊘</div>
    <div class="empty-title">No Profitable Arbitrage Routes Found</div>
    <div class="empty-desc">
      No trade routes match your current city pair, minimum profit, and stale/liquidity filters. Try clearing city filters or lowering the minimum profit threshold.
    </div>
  </div>

  <!-- Table Legend Footer -->
  <div class="table-legend">
    <div class="legend-item">
      <span class="legend-dot green"></span>
      <span>Fresh (&lt;15m)</span>
    </div>
    <div class="legend-item">
      <span class="legend-dot amber"></span>
      <span>Aging (15-60m)</span>
    </div>
    <div class="legend-item">
      <span class="legend-dot red"></span>
      <span>Stale (&gt;60m STALE)</span>
    </div>
    <div class="legend-divider"></div>
    <div class="legend-item">
      <span class="legend-badge-sample safe">SAFE ROUTE</span>
      <span>= Fresh Quote + Liquid Market</span>
    </div>
    <div class="legend-item">
      <span class="legend-badge-sample aging">AGING CAUTION</span>
      <span>= Price Quote 15-60m Old</span>
    </div>
    <div class="legend-item">
      <span class="legend-badge-sample illiquid">ILLIQUID / STALE</span>
      <span>= High Slippage Risk</span>
    </div>
    <div class="legend-divider"></div>
    <div class="legend-item">
      <span class="legend-lime tabular-figures">+Net Profit</span>
      <span>= Clean profit after deduction of sales tax & setup fee</span>
    </div>
  </div>
</div>

<style>
  .arbitrage-matrix-container {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Filter Bar */
  .arbitrage-filter-bar {
    padding: 1rem 1.25rem;
    background-color: var(--surface-primary);
    border-bottom: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .route-filter-row {
    align-items: flex-end;
  }

  .tax-risk-row {
    align-items: center;
    padding-top: 0.65rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.06);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .select-wrapper {
    position: relative;
    min-width: 180px;
  }

  .custom-select {
    width: 100%;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-hairline);
    color: var(--text-primary);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    padding: 0.4rem 0.65rem;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .custom-select:hover,
  .custom-select:focus {
    border-color: var(--accent-primary);
  }

  .swap-action-wrap {
    display: flex;
    align-items: flex-end;
    padding-bottom: 1px;
  }

  .swap-btn {
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    font-size: 1rem;
    padding: 0.35rem 0.65rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .swap-btn:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .profit-input-group {
    min-width: 150px;
  }

  .input-with-unit {
    display: flex;
    align-items: center;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    padding-right: 0.6rem;
    transition: border-color 0.15s ease;
  }

  .input-with-unit:focus-within {
    border-color: var(--accent-primary);
  }

  .custom-num-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.78rem;
    padding: 0.4rem 0.5rem 0.4rem 0.65rem;
  }

  .input-unit {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .reset-group {
    margin-left: auto;
  }

  .reset-btn {
    background-color: transparent;
    border: 1px solid var(--border-hairline);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.4rem 0.75rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .reset-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  /* Toggle Button */
  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    padding: 0.38rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-secondary);
    transition: all 0.15s ease;
    text-align: left;
    cursor: pointer;
  }

  .toggle-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-hairline);
  }

  .toggle-btn.active {
    background-color: var(--surface-elevated);
    border-color: var(--border-hairline);
    color: var(--text-primary);
  }

  .toggle-indicator {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background-color: var(--border-hairline);
    flex-shrink: 0;
    transition: background-color 0.15s ease;
  }

  .toggle-btn.active .toggle-indicator {
    background-color: var(--accent-primary);
  }

  /* Checkboxes */
  .checkboxes-group {
    flex-direction: row;
    align-items: center;
    gap: 1.25rem;
    margin-left: 0.5rem;
  }

  .custom-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-secondary);
    cursor: pointer;
    user-select: none;
  }

  .custom-checkbox-label input[type="checkbox"] {
    accent-color: var(--accent-primary);
    width: 14px;
    height: 14px;
    cursor: pointer;
  }

  /* Toolbar */
  .table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border-hairline);
    background-color: var(--surface-primary);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .table-headline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .toolbar-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .count-badge {
    font-size: 0.72rem;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
  }

  .source-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .source-status.live {
    color: var(--accent-mint);
  }

  .source-status.offline {
    color: var(--accent-amber);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sort-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .sort-buttons {
    display: flex;
    gap: 0.25rem;
  }

  .sort-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: all 0.15s ease;
  }

  .sort-btn:hover {
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .sort-btn.active {
    background-color: var(--border-hairline);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 700;
  }

  .sort-arrow {
    font-size: 0.65rem;
  }

  /* Table Styles */
  .table-scroll-wrapper {
    overflow-x: auto;
    width: 100%;
    background-color: var(--bg-primary);
  }

  .arbitrage-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .arbitrage-table thead th {
    background-color: var(--surface-primary);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border-hairline);
    user-select: none;
  }

  .sortable-th {
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .sortable-th:hover {
    color: var(--text-primary);
    background-color: var(--surface-elevated);
  }

  .sortable-th.active-sort {
    color: var(--accent-primary);
    background-color: rgba(199, 245, 59, 0.04);
  }

  .th-content {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .col-sort-icon {
    font-size: 0.65rem;
    color: var(--accent-primary);
  }

  .num-cell-right,
  th.num-cell-right {
    text-align: right;
  }

  .arbitrage-table tbody td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border-hairline);
    vertical-align: middle;
  }

  .arbitrage-table tbody tr {
    transition: background-color 0.12s ease;
  }

  .arbitrage-table tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  /* Column Specific Cell Styles */
  .tier-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.74rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-primary);
  }

  .tier-t4 { border-color: #5A6270; color: #D1D5DB; }
  .tier-t5 { border-color: rgba(56, 189, 248, 0.4); color: #38BDF8; }
  .tier-t6 { border-color: rgba(245, 158, 11, 0.4); color: #F59E0B; }
  .tier-t7 { border-color: rgba(239, 68, 68, 0.4); color: #EF4444; }
  .tier-t8 { border-color: rgba(168, 85, 247, 0.5); color: #C084FC; }

  .item-cell {
    display: flex;
    flex-direction: column;
  }

  .item-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .item-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .route-wrapper {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .city-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .city-name.caerleon {
    color: #F87171;
  }

  .route-arrow {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .price-cell-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .price-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  .silver-unit {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-left: 0.2rem;
  }

  /* Age Badges */
  .age-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.1rem 0.38rem;
    border-radius: 3px;
    border: 1px solid transparent;
  }

  .age-badge .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .age-badge.fresh {
    background-color: rgba(78, 229, 182, 0.08);
    border-color: rgba(78, 229, 182, 0.25);
    color: var(--accent-mint);
  }
  .age-badge.fresh .dot {
    background-color: var(--accent-mint);
  }

  .age-badge.aging {
    background-color: rgba(245, 166, 35, 0.08);
    border-color: rgba(245, 166, 35, 0.25);
    color: var(--accent-amber);
  }
  .age-badge.aging .dot {
    background-color: var(--accent-amber);
  }

  .age-badge.stale {
    background-color: rgba(255, 77, 77, 0.1);
    border-color: rgba(255, 77, 77, 0.3);
    color: var(--accent-danger);
  }
  .age-badge.stale .dot {
    background-color: var(--accent-danger);
  }

  /* Net Profit */
  .net-profit-val {
    font-weight: 700;
    font-size: 0.88rem;
  }

  .net-profit-val.positive {
    color: var(--accent-primary); /* Electric Lime #C7F53B */
  }

  .net-profit-val.negative {
    color: var(--accent-danger);
  }

  /* Net Margin */
  .net-margin-val {
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    display: inline-block;
  }

  .net-margin-val.positive {
    color: var(--accent-primary);
    background-color: rgba(199, 245, 59, 0.08);
    border: 1px solid rgba(199, 245, 59, 0.25);
  }

  .net-margin-val.negative {
    color: var(--accent-danger);
    background-color: rgba(255, 77, 77, 0.08);
    border: 1px solid rgba(255, 77, 77, 0.25);
  }

  /* Target 24h Volume */
  .volume-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .volume-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  .liq-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.08rem 0.35rem;
    border-radius: 2px;
    letter-spacing: 0.02em;
  }

  .liq-badge.liq-high {
