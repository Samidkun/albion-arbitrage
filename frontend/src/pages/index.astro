---
// AlbionFlow - Refining Optimizer
import Layout from '../layouts/Layout.astro';
import ControlBar from '../components/ControlBar.astro';
import RefiningTable from '../components/RefiningTable.astro';
---

<Layout title="AlbionFlow — Refining Optimizer">
  <ControlBar />

  <section class="refining-container panel" id="refining-view">
    <header class="section-header">
      <div class="header-left">
        <h1 class="section-title">REFINING OPTIMIZATION MATRIX</h1>
        <p class="section-subtitle">
          Real-time resource return rate (RRR) calculation, station nutrition fees, and Silver per Focus (SPF) rankings.
        </p>
      </div>
      <div class="header-right">
        <span class="status-indicator live">
          <span class="dot"></span>
          ENGINE READY
        </span>
      </div>
    </header>

    <!-- Refining Matrix Table Component (Task 3.2) -->
    <RefiningTable />
  </section>
</Layout>

<style>
  .refining-container {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-hairline);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--accent-mint);
  }

  .status-indicator .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-mint);
  }
</style>
